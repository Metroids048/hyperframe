    body{font-family:"Microsoft YaHei", "PingFang SC", Arial, sans-serif;text-rendering:geometricPrecision}
    [data-composition-id="commerce-root"]{position:relative;width:100%;height:100%;overflow:hidden;--bg:#0D0D0F;--fg:#F5F1E8;--panel:#18181B;--accent:#D9B26F;--accentContrast:#111111}
