    [data-composition-id="commerce-root"]{position:relative;width:100%;height:100%;overflow:hidden;--bg:#F6E8EC;--fg:#241A1D;--panel:#FFF8FA;--accent:#B85C78;--accentContrast:#FFFFFF}
