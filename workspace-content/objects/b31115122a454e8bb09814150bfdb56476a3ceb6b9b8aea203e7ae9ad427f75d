    <script>
      (function () {
        window.__timelines = window.__timelines || {};
        var tl = gsap.timeline({ paused: true });

        gsap.set("#s4 .wd", { x: 139, opacity: 0 });
        gsap.set("#s4-preview", { scale: 0.24 });

        /* ---- 1. word-by-word cut-the-curve LEFT ---- */
        tl.to("#s4 .wd", { x: 0, opacity: 1, duration: 0.46, ease: "power4.out",
          stagger: 0.085 }, 0);

        /* ---- 2. the CHARACTER glitch: every glyph cycles through a pool and
           resolves left to right, word by word. Pure function of progress — no
           random, no accumulation — so a cold seek matches the render. ---- */
        var WORDS = [].slice.call(document.querySelectorAll("#s4 .wd"));
        var FINAL = WORDS.map(function (el) { return el.textContent; });
        /* The pool is WIDTH-BOUNDED, measured off the font itself, not eyeballed.
           Copernicus is far wider than the Georgia it replaced: "HyperFrames completes
           it." runs 1087px at 80px and was clipping the final period off both ends of
           the frame. Two things fix it together — 68px for the real line (938px, the SAME measure as the ABC Solar phase that
           follows, so the mid-scramble typeface swap is not also a size jump), and
           dropping every glyph whose advance exceeds 0.60em (W 1.148, @ 1.108, M 1.089,
           %% 1.045, m 1.035 ... 48 glyphs cut) so a scrambled frame can never exceed the
           real line by more than 0.8%%. Worst case is now 866px; the real line is the binding constraint, at 71px clear.
           Still deterministic — a smaller pool, same hash, no random. */
        var POOL = "IJcefgijlrstvxyz123578$*/[]{}~?!";
        var STEPS = 22;
        function hash(i) { var v = Math.sin(i * 127.1) * 43758.5453; return v - Math.floor(v); }
        var GL = { p: 0 };
        function paintGlitch() {
          var step = Math.min(STEPS, Math.floor(GL.p * STEPS));
          for (var w = 0; w < WORDS.length; w++) {
            var t = FINAL[w], out = "";
            /* each word resolves on its own slightly later schedule */
            var res = (GL.p - w * 0.035) / 0.62;
            for (var i = 0; i < t.length; i++) {
              var ch = t.charAt(i);
              if (ch === "." || ch === " ") { out += ch; continue; }
              var settled = (i + 1) / t.length <= res;
              out += settled ? ch
                : POOL.charAt(Math.floor(hash(step * 31 + w * 17 + i * 7) * POOL.length));
            }
            WORDS[w].textContent = out;
          }
        }
        tl.fromTo(GL, { p: 0 }, { p: 1, duration: 0.68, ease: "none",
          onUpdate: paintGlitch, immediateRender: false }, 1.69);
        /* the world changes UNDER the scramble */
        /* mid-scramble the TYPE changes, still dark on paper */
        tl.set("#s4-thesis", { fontFamily: "ABCSolar, sans-serif", color: "#1A1A18",
          fontWeight: 700, fontSize: 74 }, 1.94);
        /* "completes" is the word the film is built to land — it takes the HyperFrames
           green the moment the brand identity does */
        /* on cream the brand green is far too light, so this is the same hue darkened */
        tl.set("#s4-completes", { color: "#2E9E5B" }, 1.94);
        /* land it exactly on the real words */
        tl.call(function () { WORDS.forEach(function (el, i) { el.textContent = FINAL[i]; }); },
          null, 2.37);

        /* ---- the world flips DURING the scramble, and is DONE before it resolves ----
           It used to fire AT 2.37, the frame the scramble landed on, so the eye read two
           sequential events (letters settle, THEN the world changes) with a dead frame
           between them. Now it ignites on the SAME frame as the type change (1.94) — one
           cause, one effect — and every part of it has landed by 2.12, a quarter second
           before the glyphs stop cycling at 2.37. So the words resolve INTO the new world
           instead of summoning it.
           The plate's clip gate had to move with it: data-start was 2.30, which would have
           held the video out of the document for the whole fade. It is now 1.94, exactly
           its entry tween, with the duration extended to keep the same 6.30 out-point.
           Order within the flip is unchanged — the ink inverts one frame after the plate
           starts coming up so light type never sits on a still-light ground, and on the
           dark plate the true brand green reads, so "completes" goes back to #38D878. */
        tl.to("#s4-bg", { opacity: 1, duration: 0.16, ease: "none" }, 1.94);
        tl.set("#s4-thesis", { color: "#F2FBF6" }, 1.98);
        tl.set("#s4-completes", { color: "#38D878" }, 1.98);
        tl.to("#s4 .paper", { opacity: 0, duration: 0.10, ease: "none" }, 2.02);

        /* ---- 3. the lines leave: top UP, bottom DOWN, word by word, FULLY off
           frame. No opacity — the frame edge hides them. ---- */
        tl.to("#s4-l1 .wd", { y: -760, duration: 0.66, ease: "power3.in", stagger: 0.075 }, 2.75);
        tl.to("#s4-l2 .wd", { y: 760, duration: 0.66, ease: "power3.in", stagger: 0.075 }, 2.75);

        /* ...and the full preview opens from the centre through the gap */
        tl.to("#s4-preview", { opacity: 1, scale: 1, duration: 0.78, ease: "power3.out" }, 3.27);

        /* ---- 4. the video is about what HyperFrames ADDS: music, sfx, polish ----
           DIRECTION REVERSED on Jake's note: the sections slide DOWN to each other, never
           up. Each outgoing beat now exits to y:+150 and each incoming enters from y:-150,
           so the whole run travels one way — downward — like a reel being advanced. It used
           to be the mirror of this (exit up, enter from below). One direction per chain per
           the vector law; keep any new beat on the same sign. */
        gsap.set("#s4 .bars i", { scaleY: 0.08 });

        tl.to("#s4-b1", { opacity: 0, y: 150, duration: 0.22, ease: "power2.in" }, 5.50);
        tl.fromTo("#s4-b2", { opacity: 0, y: -150 },
          { opacity: 1, y: 0, duration: 0.30, ease: "power3.out", immediateRender: false }, 5.64);
        tl.to("#s4 .bars i", { scaleY: 1, duration: 0.30, ease: "back.out(2)",
          stagger: { each: 0.035, from: "center" } }, 5.72);
        tl.to("#s4 .bars i", { scaleY: 0.34, duration: 0.26, ease: "sine.inOut",
          stagger: { each: 0.045, from: "edges" }, yoyo: true, repeat: 1 }, 6.06);

        tl.to("#s4-b2", { opacity: 0, y: 150, duration: 0.22, ease: "power2.in" }, 6.38);
        tl.fromTo("#s4-b3", { opacity: 0, y: -150 },
          { opacity: 1, y: 0, duration: 0.30, ease: "power3.out", immediateRender: false }, 6.52);
        /* the three clips expand left-to-right in their lanes. Hand-placed rather than
           a uniform stagger so the gaps SHRINK (0.13 -> 0.11, x0.846) — an accelerating
           cascade per cut-the-curve §6, not a metronome. power3.out because an expand is
           an arrival; the last one lands 7.14, 0.12s before the beat leaves at 7.26. */
        tl.to("#s4-sfx1", { clipPath: "inset(0px 0px 0px 0px)", duration: 0.26, ease: "power3.out" }, 6.64);
        tl.to("#s4-sfx2", { clipPath: "inset(0px 0px 0px 0px)", duration: 0.26, ease: "power3.out" }, 6.77);
        tl.to("#s4-sfx3", { clipPath: "inset(0px 0px 0px 0px)", duration: 0.26, ease: "power3.out" }, 6.88);

        tl.to("#s4-b3", { opacity: 0, y: 150, duration: 0.22, ease: "power2.in" }, 7.26);
        tl.fromTo("#s4-b4", { opacity: 0, y: -150 },
          { opacity: 1, y: 0, duration: 0.30, ease: "power3.out", immediateRender: false }, 7.40);
        /* (the base curve no longer draws in — it is there the whole beat. The reveal is
           the .cp progress stroke below, driven from the puck's own clock so the puck always
           sits at its leading edge.) */

        tl.fromTo("#s4 .s4st", { opacity: 0, x: -10 },
          { opacity: 1, x: 0, duration: 0.30, ease: "power2.out", stagger: 0.16,
            immediateRender: false }, 4.16);
        tl.fromTo("#s4-agent", { opacity: 0, y: 12 },
          { opacity: 1, y: 0, duration: 0.40, ease: "power3.out", immediateRender: false }, 4.72);
        tl.fromTo("#s4 .s4chip", { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.28, ease: "power2.out", stagger: 0.075,
            immediateRender: false }, 5.30);
        tl.fromTo("#s4-escrub", { width: "0%" },
          { width: "100%", duration: 4.30, ease: "none", immediateRender: false }, 4.10);
        tl.fromTo("#s4-playhead", { x: 0 },
          { x: 500, duration: 4.30, ease: "none", immediateRender: false }, 4.10);

        /* ---- 5. the same move S2 makes: the video takes the whole frame.
           Slot is 392 at (292.5, 261); 1080/392 = 2.75510, origin 0 0, so the offsets
           are its own position negated. The chrome falls away as it grows. ---- */
        tl.set("#s4-slot392", { zIndex: 40 }, 4.40);
        tl.to("#s4-slot392", { scale: 2.75510, x: -292.5, y: -261,
          duration: 0.96, ease: "power3.inOut" }, 4.40);
        tl.to("#s4 .bar",    { opacity: 0, duration: 0.44, ease: "power2.in" }, 4.44);
        tl.to("#s4 .tasks",  { opacity: 0, duration: 0.44, ease: "power2.in" }, 4.47);
        tl.to("#s4 .chat",   { opacity: 0, duration: 0.44, ease: "power2.in" }, 4.50);
        tl.to("#s4 .prow",   { opacity: 0, duration: 0.44, ease: "power2.in" }, 4.53);
        tl.to("#s4 .tl",     { opacity: 0, duration: 0.44, ease: "power2.in" }, 4.56);

        /* a block rides UP the eased curve — the easing demonstrated, not just drawn.
           Parametric cubic through the same control points as the path, evaluated from
           a linear proxy, so it traces the drawn line exactly.
           INVERTED on Jake's note: mirrored about x=115 so the puck (and the stroke draw,
           which follows path direction) travels RIGHT -> LEFT. That is the film's current —
           the old left-to-right read was the one beat running against it, which is very
           likely why it felt wrong. The rise is kept, so it still reads as polish. */
        var PK = { p: 0 };
        var puck = document.getElementById("s4-puck");
        /* the progress stroke's dash comes from the path's REAL length, measured once at
           parse — a guessed dasharray either under-reveals or finishes early. Guarded in
           case getTotalLength is unavailable. */
        var prog = document.getElementById("s4-eprog");
        var PLEN = (prog.getTotalLength && prog.getTotalLength()) || 270;
        prog.style.strokeDasharray = PLEN;
        prog.style.strokeDashoffset = PLEN;
        function bez(t, a, b, c, d) { var m = 1 - t;
          return m*m*m*a + 3*m*m*t*b + 3*m*t*t*c + t*t*t*d; }
        function paintPuck() {
          var x = bez(PK.p, 226, 134, 110, 4), y = bez(PK.p, 88, 88, 4, 4);
          puck.setAttribute("transform", "translate(" + x.toFixed(2) + " " + y.toFixed(2) + ")");
          /* same clock as the puck, so the reveal's leading edge and the puck cannot drift
             apart. (Parametric p is not exactly arc-length fraction, but on this gentle S the
             error is a couple of percent and both sides share it.) */
          prog.style.strokeDashoffset = (PLEN * (1 - PK.p)).toFixed(2);
        }
        tl.set("#s4-puck", { opacity: 1 }, 7.56);
        /* 0.80 -> 0.62 so the ride lands 8.18, and the comp now ends at 8.16 — the cut to
           the logo outro happens with the puck still travelling (96.8% through). That is
           both what Jake asked for and more correct than before: the old 8.70 out-point
           left 0.34s of dead hold after the puck had already settled. */
        tl.fromTo(PK, { p: 0 }, { p: 1, duration: 0.62, ease: "none",
          onUpdate: paintPuck, immediateRender: false }, 7.56);

        window.__timelines["s4"] = tl;
      })();
