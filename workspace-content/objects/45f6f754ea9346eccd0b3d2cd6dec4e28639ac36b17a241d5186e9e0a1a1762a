<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <title>Liquid Pop — Official HyperFrames Symbol</title>
    <link rel="preload" href="assets/hyperframes-symbol.svg" as="image" crossorigin />
    <link rel="preload" href="assets/hyperframes-wordmark-official.svg" as="image" crossorigin />
    <link rel="preload" href="assets/equirect-garden.jpg" as="image" crossorigin />
    <script src="assets/gsap.min.js"></script>
    <script type="importmap">
      { "imports": { "three": "./node_modules/three/build/three.module.js" } }
    </script>
    <style>
      * { box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; margin: 0; overflow: hidden; background: #f4f2ea; }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: transparent; }
      #liquid-pop-canvas { position: absolute; inset: 0; display: block; width: 1920px; height: 1080px; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="liquid-pop-hyperframes-official" data-brand="hyperframes-official" data-logo-src="assets/hyperframes-symbol.svg" data-wordmark-src="assets/hyperframes-wordmark-official.svg" data-start="0" data-duration="6" data-fps="30" data-width="1920" data-height="1080">
      <canvas id="liquid-pop-canvas" class="clip" data-start="0" data-duration="6" data-track-index="1" aria-hidden="true"></canvas>
    </div>
    <script>
      window.__timelines = window.__timelines || {};
      window.__liquidTimelineState = { time: 0 };
      const liquidTimeline = gsap.timeline({ paused: true });
      liquidTimeline.to(window.__liquidTimelineState, { time: 6, duration: 6, ease: "none" });
      window.__timelines["liquid-pop-hyperframes-official"] = liquidTimeline;
      liquidTimeline.seek(0);
    </script>
    <script type="module" src="js/liquid-pop-v2.js"></script>
  </body>
</html>
