    <script>
      (function () {
        window.__timelines = window.__timelines || {};
        var tl = gsap.timeline({ paused: true });

        /* cursor parked off-frame at parse: revealing it with a tl.set and only THEN
           applying a fromTo's from-state flashes it at its resting position (on Share)
           for one frame first. */
        gsap.set("#s2-cur-rise", { x: 210, y: 470 });

        /* ---- THE CAMERA — the rest of S1's pull-back ----
           S1 makes one move in to the plan, holds, then starts pulling back at master
           15.20. That pull is ONE move spanning the seam; S1 renders its first 0.4413s and
           this renders the remaining 0.8587s, both evaluating the SAME ease over the SAME
           window. That is deliberate, not stylistic: the seam is not frame-aligned
           (15.6413 x 24 = 375.4), so S1's last frame is master 15.625 and this comp's first
           is 15.6667. Anything that merely "starts where S1 ended" reverses by one frame's
           worth of easing and reads as a hitch.

           The window runs to master 16.50 = local 0.8587 ON PURPOSE. It used to end at
           local 0.32, so the zoom-out finished and THEN the UI assembled — Jake read that
           as a "stepped" zoom-out. Now the camera is still pulling back while the rail,
           topbar, canvas and player arrive (0.34-1.20) and while the plan shrinks into the
           rail (0.06-0.92), so it is one continuous motion into the full UI. Everything
           shrinks together, which is the same Z sign on both sides of the cut per the
           vector law.

           KEEP IN SYNC WITH s1-square.html: PULL_T0, PULL_D and pullEase live there too. */
        var PULL_T0 = 15.20, PULL_D = 1.30, S1_END = 15.6413;
        var PULL_DONE = PULL_D - (S1_END - PULL_T0);   /* 0.8587s left to run here */
        function pullEase(u) {
          u = u < 0 ? 0 : u > 1 ? 1 : u;
          return u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;
        }
        /* q is 1 by the time we get here — the move in is complete, so the held state is
           baked in and only the release is left to animate. */
        var CAM = { k: S1_END - PULL_T0 };
        var camEl = document.getElementById("s2-cam");
        function paintCam() {
          var a = 1 - pullEase(CAM.k / PULL_D);
          /* MUST match s1-square.html's paintCam held state exactly: scale 1.48, and x
             derived from the scale (-(s-1)*118) so the checkbox column stays pinned. */
          camEl.style.transform = "translate3d(" + (-0.48 * 118 * a).toFixed(3) + "px," +
            (-263.20 * a).toFixed(3) + "px,0) scale(" + (1 + 0.48 * a).toFixed(5) + ")";
        }
        paintCam();   /* frame 0 must already BE the zoomed state, so paint at parse */
        tl.to(CAM, { k: PULL_D, duration: PULL_DONE, ease: "none", onUpdate: paintCam }, 0);
        /* Share pill parked above the bar's clipped top edge, at parse for the same
           reason. Travel is 30px against a ~42px pill, so it emerges from behind the
           edge rather than popping in at rest. */
        gsap.set("#s2-share", { y: -30 });

        /* per-character mask boxes for the composer placeholder, built once at parse */
        (function () {
          var cph = document.getElementById("s2-cph");
          var txt = cph.textContent;
          cph.textContent = "";
          for (var i = 0; i < txt.length; i++) {
            var outer = document.createElement("span"); outer.className = "chw";
            var inner = document.createElement("span"); inner.className = "chi";
            inner.textContent = txt.charAt(i) === " " ? "\u00A0" : txt.charAt(i);
            outer.appendChild(inner); cph.appendChild(outer);
          }
        })();

        /* park everything that reveals from behind a mask, at t=0 */
        tl.set("#s2 .rline span", { yPercent: 100 }, 0);
        tl.set("#s2 .chi", { yPercent: 100 }, 0);
        /* .crow children and .s2mi rows are hidden in CSS, not by a tl.set at 0 —
           a zero-duration set at position 0 does not render on frame 0. The menu rows
           being hidden up front is also what stops them revealing TWICE: previously they
           were visible through the container's fade, then snapped to 0 and faded again. */
        tl.set("#s2 .s2mi", { y: 10 }, 0);

        /* ================= K5 · S2a — the morph in from S1 ================= */
        /* t=0 is identity, so this frame equals S1's last frame exactly. */
        tl.fromTo("#s2-planmorph", { scale: 1, x: 0, y: 0 },
