    <script>
      /* =====================================================================
         HeyGen message sting — 12.8s, 720x720 @30fps, one continuous shot.
         Motion grammar: entries are exponential-out with long tails, exits are
         exponential-in, and every scene change is a shared-element morph (an
         edge-on flip, a zoom-through, or a same-rect crossfade) so the film
         reads as one camera move. EO/EI are explicit functions — GSAP's
         built-in "expo" is a different polynomial.
         ===================================================================== */
      const FPS = 30;
      const F = (f) => f / FPS;              // frame index -> seconds
      const tl = gsap.timeline({ paused: true });
      const EO = (p) => (p >= 1 ? 1 : 1 - Math.pow(2, -10 * p));
      const EI = (p) => (p <= 0 ? 0 : Math.pow(2, 10 * (p - 1)));
      const $ = (s) => document.querySelector(s);
      // seeded RNG (deterministic)
      function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}

      /* ---------- A : build the 3 skeleton cards ------------------------- */
      const CARDS = [
        { x: 200, y: 268, w: 330, h: 112, img: "assets/thumb-stein.jpg",    dur: "0:12" },
        { x: 352, y: 298, w: 240, h: 172, img: "assets/thumb-tower-b.jpg",  dur: "0:27" },
        { x: 110, y: 308, w: 352, h: 146, img: "assets/thumb-afrasiab.jpg", dur: "0:48" },
      ];
      document.querySelector("#a-stack").insertAdjacentHTML("beforeend", CARDS.map((c, i) =>
        `<div class="acard" id="a-c${i}" data-layout-allow-overlap style="left:${c.x}px;top:${c.y}px;width:${c.w}px;height:${c.h}px">
           <img class="athumb" src="${c.img}" alt="">
           <div class="aplay"><span></span></div>
           <div class="adur">${c.dur}</div>
         </div>`).join(""));

      /* ---------- C : 8 seeded glyph-cloud states ------------------------ */
      const GLY = "#%^&*=$/\\{}<>()!?~+@|";
      const rand = mulberry32(20260804);
      const ROWS = [
        [55, 1],[97, -1],[139, 1],[181, -1],[223, 1],[265, -1],[307, 1],[349, -1],[391, 1]
      ];
      /* each row is one LONG strip sliding continuously across the circle —
         alternating directions per row, fluid */
      let rowsHtml = "";
      ROWS.forEach(([cy, dir], ri) => {
        let parts = "", used = 0;
        while (used < 2400) {
          if (rand() < 0.45) { const pw = 50 + Math.floor(rand()*80); parts += `<span class="cpill" style="width:${pw}px"></span>`; used += pw+12; }
          else { const n = 2 + Math.floor(rand()*4); let g=""; for(let k=0;k<n;k++) g += GLY[Math.floor(rand()*GLY.length)] + " "; parts += g; used += n*26; }
        }
        rowsHtml += `<div class="crow" id="crow${ri}" style="top:${cy-19}px;left:${dir>0?-1400:-600}px">${parts}</div>`;
      });
      $("#c-circle").insertAdjacentHTML("afterbegin", `<div class="cstate" id="cs0">${rowsHtml}</div>`);

      /* ---------- G : stars ------------------------------------------------ */
      const star = (fill) => `<svg viewBox="0 0 24 24"><path fill="${fill}" d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>`;
      $("#g-stars").innerHTML = star("#8e8e96")+star("#8e8e96")+star("#8e8e96")+star("#8e8e96")+star("#c9c9ce");

      /* ---------- H : friend rows ---------------------------------------- */
      const HROWS = [
        { c:"#6cd388", x:90,  y:60,  w:465, h:130, ttl:"Script approved",
          asset:`<div class="hline">EXT. SILK ROAD — DAY</div>
                 <div class="hline hl">VO: “Two thousand years ago, a letter…”</div>
                 <div class="hline">CUT TO: watchtower ruins, slow push-in</div>` },
        { c:"#fdda53", x:138, y:210, w:375, h:130, ttl:"Avatar scene recorded",
          asset:`<img class="hthumb" src="assets/status-avatar.jpg" alt=""><div class="hrec"></div><div class="hchip">0:14</div>` },
        { c:"#f9a44a", x:186, y:360, w:285, h:130, ttl:"B-roll added",
          asset:`<img class="hthumb" src="assets/status-broll.jpg" alt=""><div class="hchip">4K</div>` },
        { c:"#f2555a", x:231, y:510, w:190, h:68, ttl:"", asset:"", done:"Done ✓" },
      ];
      const person = `<svg viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="8.4" r="4.1"/><path d="M4.5 20.2c0-4.1 3.4-6.6 7.5-6.6s7.5 2.5 7.5 6.6z"/></svg>`;
      $("#h-rows").innerHTML = HROWS.map((r,i) =>
        `<div class="hrow${r.done?" compact":""}" id="hr${i}" data-layout-allow-overlap style="left:${r.x}px;top:${r.y}px;width:${r.w}px;height:${r.h}px">
           <div class="hav" style="width:44px;height:44px;background:${r.c}">${person}</div>
           ${r.done ? `<div class="hdone">${r.done}</div>`
                    : `<div class="htitle">${r.ttl}</div><div class="hasset" id="ha${i}">${r.asset}</div>`}
         </div>`).join("");

      /* =====================================================================
         CHOREOGRAPHY
         ===================================================================== */

      /* ---- A : cards enter from lower-left (fits: cx 246→337 tau.25, cy 513→379 tau.32) */
      gsap.set("#a-stack", { autoAlpha: 1 });
      /* cards arrive one at a time, each with its own settle bounce:
         front (a-c2) first from lower-left, right (a-c1) from lower-right,
         back-top (a-c0) last from behind. rotation overshoots with the bounce. */
      const CARD_IN = [
        { sel: "#a-c2", f: 0.5, dx: -120, dy: 150, r0: -10, r1: -3,  blur: 8 },
        { sel: "#a-c1", f: 3.2, dx: 70,   dy: 230, r0: 16,  r1: 10,  blur: 7 },
        { sel: "#a-c0", f: 7.0, dx: 30,   dy: 150, r0: 10,  r1: 5,   blur: 6 },
      ];
      CARD_IN.forEach((c) => {
        gsap.set(c.sel, { x: c.dx, y: c.dy, rotation: c.r0, autoAlpha: 0, filter: `blur(${c.blur}px)` });
        tl.to(c.sel, { autoAlpha: 1, duration: 0.1, ease: "none" }, F(c.f));
        tl.to(c.sel, { x: 0, duration: 0.55, ease: (p)=>1-Math.pow(2,-10*p*0.55/0.22) }, F(c.f));
        tl.to(c.sel, { y: 0, rotation: c.r1, duration: 0.6, ease: "back.out(1.55)" }, F(c.f));
        tl.to(c.sel, { filter: "blur(0px)", duration: 0.3, ease: "power2.out" }, F(c.f + 1));
      });
      /* the front card keeps turning slightly through the hold — the 3D tell */
      tl.to("#a-c2", { rotation: -4.5, duration: 0.55, ease: "none" }, F(14));
      tl.to("#a-stack", { y: 4, duration: 0.65, ease: "none" }, F(11)); // ambient drift
      /* A exit: edge-on flip about x=374 */
      tl.to("#a-stack", { scaleX: 0.02, duration: F(34.4) - F(30), ease: EI }, F(30));
      tl.to("#a-stack", { filter: "blur(7px)", duration: 0.1, ease: "power1.in" }, F(31));
      tl.to("#a-stack", { autoAlpha: 0.22, duration: F(34.4)-F(31), ease: "power2.in" }, F(31));

      /* ---- B : bubble regrows from the flip axis ---- */
      tl.set("#b-bub", { scaleX: 0.03 }, F(34));
      tl.set(".bdot,#b-dtex", { autoAlpha: 0 }, F(34));
      tl.to("#b-bub", { scaleX: 1, duration: 0.32, ease: EO }, F(34.9));
      gsap.set("#b-bub", { filter: "blur(6px)" });
      tl.to("#b-bub", { filter: "blur(0px)", duration: 0.28, ease: "power2.out" }, F(35));
      tl.to(".bdot", { autoAlpha: 1, duration: 0.12, ease: EO, stagger: 0.03 }, F(36.5));
      /* dots wave — finite repeats, no repeat:-1 */
      for (let cyc = 0; cyc < 2; cyc++) {
        ["#b-d0","#b-d1","#b-d2"].forEach((d, k) => {
          const t0 = F(38) + cyc * 0.55 + k * 0.16;
          tl.to(d, { scale: 1.18, autoAlpha: 1,   duration: 0.2, ease: "power2.out" }, t0);
          tl.to(d, { scale: 0.92, autoAlpha: 0.45, duration: 0.28, ease: "power2.inOut" }, t0 + 0.2);
        });
      }
      tl.to(".bdot", { autoAlpha: 1, scale: 1, duration: 0.18, ease: "power2.out" }, F(54));
      /* glyph texture soaks into the middle dot as the zoom begins */
      tl.to("#b-dtex", { autoAlpha: 1, duration: 0.2, ease: "power1.in" }, F(59));
      /* zoom-through the middle dot (h 179→668+ accelerating) */
      tl.to("#b-zoom", { scale: 8.2, duration: F(67.6) - F(56), ease: "power2.in" }, F(56));
      tl.to("#b-zoom", { filter: "blur(2.2px)", duration: F(67.6) - F(58), ease: "power2.in" }, F(58));
      /* gray world fades up under the zoom */
      gsap.set("#ground", { autoAlpha: 0 });
      tl.to("#ground", { autoAlpha: 1, duration: F(68.5) - F(66), ease: "power1.in" }, F(66));

      /* ---- C : glyph circle — enters mid-grow (carrier = the dot) ---- */
      gsap.set("#c-fill", { autoAlpha: 0 });
      tl.fromTo("#c-circle", { scale: 0.48 }, { scale: 1, duration: 0.62, ease: (p)=>1-Math.pow(2,-10*p*0.62/0.25) }, F(66.8));
      gsap.set("#c-circle", { filter: "blur(11px)" });
      tl.to("#c-circle", { filter: "blur(0px)", duration: 0.32, ease: "power2.out" }, F(67));
      /* rows slide continuously, alternating directions, slight per-row speed variety */
      const SPD = [700, -770, 720, -820, 760, -730, 790, -710, 740];
      SPD.forEach((v, ri) => {
        tl.to(`#crow${ri}`, { x: v * 1.55, duration: 1.55, ease: "power1.in" }, F(67));
      });
      /* colorize gray → steel blue → vivid */
      tl.to(".cstate", { color: "#54c2e0", duration: F(109)-F(100), ease: "power1.inOut" }, F(100));
      tl.to(".cstate", { color: "#0fb4ef", duration: F(113)-F(109), ease: "power1.in" }, F(109));
      /* collapse into the dot */
      tl.to("#c-circle", { scale: 54/390, duration: F(113.2)-F(110), ease: "power2.in" }, F(110));
      tl.to("#c-circle", { filter: "blur(8px)", duration: F(113.2)-F(110), ease: "power2.in" }, F(110));
      tl.to("#c-fill", { autoAlpha: 1, duration: F(113)-F(110.5), ease: "power1.in" }, F(110.5));
      tl.set("#c-circle", { autoAlpha: 0 }, F(113.4));

      /* ---- D : dot rest, then inflate to the send pill ---- */
      gsap.set("#d-pill", { autoAlpha: 0 });
      gsap.set("#d-tail", { scale: 0, autoAlpha: 0 });
      tl.set("#d-pill", { autoAlpha: 1 }, F(113.4));
      tl.fromTo("#d-pill", { scale: 1.04 }, { scale: 1, duration: 0.18, ease: "power2.out" }, F(113.4));
      /* inflate: w 54→437 h 54→177, tau .44/.30 — element left/top/w/h tweened so radius stays capsule */
      tl.to("#d-pill", {
        width: 400, height: 177, x: -179, y: -59,
        duration: 1.05, ease: (p)=>1-Math.pow(2,-10*p*1.05/0.44),
      }, F(120));
      tl.fromTo("#d-pill", { filter: "blur(5px)" }, { filter: "blur(0px)", duration: 0.3, ease: "power2.out" }, F(120));
      tl.to("#d-tail", { scale: 1, autoAlpha: 1, duration: 0.3, ease: EO }, F(129));
      gsap.set("#d-msg", { autoAlpha: 0 });
      tl.to("#d-msg", { autoAlpha: 1, duration: 0.25, ease: "power1.out" }, F(131));
      tl.to("#d-msg", { autoAlpha: 0, duration: 0.12, ease: "power1.in" }, F(140));
      /* exit flip: rotZ −62° + edge-on collapse */
      tl.to("#d-pill", { rotation: -62, duration: F(151.5)-F(140), ease: "power2.in" }, F(140));
      tl.to("#d-wrap", { x: 5, y: -2.5, duration: F(151.5)-F(140), ease: "power2.in" }, F(140));
      tl.to("#d-pill", { scaleX: 0.04, duration: F(151.5)-F(143), ease: EI }, F(143));
      tl.to("#d-pill", { scaleY: 0.5, duration: F(151.5)-F(145), ease: "power3.in" }, F(145));
      tl.to("#d-pill", { filter: "blur(9px)", duration: F(151.5)-F(143), ease: "power2.in" }, F(143));
      tl.to("#ground", { autoAlpha: 0, duration: F(156)-F(150.5), ease: "power1.out" }, F(150.5));

      /* ---- E : plus icon unrolls from the sliver ---- */
      tl.set("#e-plus", { rotation: -38, scale: 0.28, autoAlpha: 1 }, F(151));
      tl.set("#e-halo", { scale: 171/384, autoAlpha: 0 }, F(151));
      tl.set(".estroke", { autoAlpha: 0 }, F(151));
      tl.to("#e-plus", { rotation: 0, duration: 0.55, ease: (p)=>1-Math.pow(2,-10*p*0.55/0.22) }, F(152));
      gsap.set("#e-plus", { filter: "blur(7px)" });
      tl.to("#e-plus", { filter: "blur(0px)", duration: 0.3, ease: "power2.out" }, F(152));
      tl.to("#e-plus", { scale: 1, duration: 0.5, ease: (p)=>1-Math.pow(2,-10*p*0.5/0.20) }, F(152));
      tl.to("#e-halo", { autoAlpha: 1, duration: 0.12, ease: "power1.out" }, F(152));
      tl.to("#e-halo", { scale: 1, duration: 0.5, ease: (p)=>1-Math.pow(2,-10*p*0.5/0.22) }, F(152));
      tl.to(".estroke", { autoAlpha: 1, duration: 0.2, ease: EO }, F(155));

      /* ---- S4 : AirPods card arrives from bottom-right; plus parks as plate ---- */
      gsap.set("#f-group", { x: 295, y: 135, autoAlpha: 0, filter: "blur(10px)" });
      gsap.set("#f-navyface", { autoAlpha: 0 });
      gsap.set("#f-hand", { x: 0, y: 0 });
      tl.to("#f-group", { autoAlpha: 1, duration: 0.1, ease: "none" }, F(167));
      tl.to("#f-group", { x: 0, duration: 1.65, ease: (p)=>1-Math.pow(2,-10*p*1.65/0.53) }, F(167));
      tl.to("#f-group", { y: 0,   duration: 1.2,  ease: (p)=>1-Math.pow(2,-10*p*1.2/0.26) }, F(167));
      tl.to("#f-group", { filter: "blur(0px)", duration: 0.3, ease: "power2.out" }, F(168));
      /* plus icon slides behind the card, halo folds away, strokes fade */
      tl.to("#e-halo", { scale: 0.42, autoAlpha: 0, duration: 0.4, ease: EI }, F(168));
      tl.to(".estroke", { autoAlpha: 0, duration: 0.25, ease: "power1.in" }, F(170));
      tl.to("#e-plus", { x: -12, y: -2, scaleX: 1.25, scaleY: 1.10, duration: 0.55, ease: (p)=>1-Math.pow(2,-10*p*0.55/0.22) }, F(169));
      /* slow drift down (tail of the entry), then near-linear shrink into an icon */
      tl.to("#f-group", { y: 14, duration: F(198)-F(180), ease: "none" }, F(180));
      tl.to("#f-group", { scale: 0.43, y: 9, duration: F(212)-F(200), ease: "power2.in" }, F(200));
      tl.to("#f-card", { height: 232, y: 49, borderRadius: 56, duration: F(212)-F(200), ease: "power2.in" }, F(200));
      tl.to("#f-photo", { y: 12, duration: F(212)-F(200), ease: "power2.in" }, F(200));
      tl.to("#f-foot", { autoAlpha: 0, duration: 0.22, ease: "power1.in" }, F(203));
      tl.to("#f-hand", { y: 40, duration: F(212)-F(200), ease: "power2.in" }, F(200));
      tl.to("#e-plus", { scale: 0.30, x: -20, y: 12, duration: F(212)-F(200), ease: "power2.in" }, F(200));
      tl.to("#e-plus",  { autoAlpha: 0, duration: 0.2, ease: "power1.in" }, F(208));
      tl.to("#f-navyface", { autoAlpha: 1, duration: F(211)-F(205), ease: "power1.in" }, F(205));
      tl.to("#f-group", { filter: "blur(7px)", duration: F(214.5)-F(206), ease: "power2.in" }, F(206));
      tl.to("#f-card", { autoAlpha: 0, duration: 0.08, ease: "none" }, F(214.6));
      tl.to("#f-hand", { x: -60, y: 200, autoAlpha: 0, duration: F(222)-F(215), ease: "power2.in" }, F(215));

      /* ---- G : music icon lands on the same rect, hand releases ---- */
      gsap.set("#g-icon", { scale: 100/140, autoAlpha: 0, x: 0, y: 0 });
      tl.to("#g-icon", { autoAlpha: 1, duration: F(216.5)-F(214), ease: "power1.out" }, F(214));
      gsap.set("#g-icon", { filter: "blur(7px)" });
      tl.to("#g-icon", { filter: "blur(0px)", duration: 0.3, ease: "power2.out" }, F(214.5));
      tl.to("#g-icon", { scale: 1, duration: 0.32, ease: EO }, F(216.2));
      /* hand exits down-left, fading (rides #sG now conceptually — implemented on #f-hand before sE ends? no: sE ends 7.1667; hand exit happens inside sG window via its own copy) */
      /* icon drifts left as the row grows */
      tl.to("#g-icon", { x: -20, duration: F(232)-F(226), ease: "power1.in" }, F(226));
      tl.to("#g-icon", { x: -121, y: -7, scale: 82/140, duration: 0.6, ease: (p)=>1-Math.pow(2,-10*p*0.6/0.24) }, F(232));
      gsap.set("#g-row", { autoAlpha: 0, scaleX: 0.32, scaleY: 0.9 });
      tl.to("#g-row", { autoAlpha: 1, duration: 0.15, ease: "power1.out" }, F(232));
      tl.to("#g-row", { scaleX: 1, scaleY: 1, duration: 0.6, ease: (p)=>1-Math.pow(2,-10*p*0.6/0.24) }, F(232));
      tl.fromTo("#g-row", { filter: "blur(3px)" }, { filter: "blur(0px)", duration: 0.25, ease: "power2.out" }, F(232));
      gsap.set("#g-ttl,#g-sub,#g-stars,#g-count,#g-cloud", { autoAlpha: 0 });
      tl.to("#g-ttl", { autoAlpha: 1, duration: 0.25, ease: EO }, F(236));
      tl.to("#g-sub,#g-stars,#g-count,#g-cloud", { autoAlpha: 1, duration: 0.3, ease: EO, stagger: 0.05 }, F(241));
      /* the finished row + icon drift as one unit */
      tl.to("#g-rowwrap,#g-icon", { y: -215, duration: F(273)-F(249), ease: "power2.in" }, F(249));
      tl.to("#g-rowwrap,#g-icon", { filter: "blur(6px)", duration: F(273)-F(258), ease: "power2.in" }, F(258));

      /* ---- H : friend rows waterfall ---- */
      gsap.set(".hrow", { autoAlpha: 0, y: 470 });
      gsap.set(".hasset", { autoAlpha: 0, scale: 0.75 });
      gsap.set(".hline", { autoAlpha: 0, x: -8 });
      [[0,263],[1,270],[2,272.5],[3,278.5]].forEach(([i, f]) => {
        tl.to(`#hr${i}`, { autoAlpha: 1, duration: 0.3, ease: "power1.out" }, F(f));
        tl.to(`#hr${i}`, { y: 0, duration: 1.3, ease: (p)=>1-Math.pow(2,-10*p*1.3/2.4) }, F(f));
        tl.fromTo(`#hr${i}`, { filter: "blur(5px)" }, { filter: "blur(0px)", duration: 0.35, ease: "power2.out" }, F(f));
        if (i < 3) tl.to(`#ha${i}`, { autoAlpha: 1, scale: 1, duration: 0.35, ease: (p)=>1-Math.pow(2,-10*p*0.35/0.14) }, F(f + 13));
      });
      tl.to("#ha0 .hline", { autoAlpha: 1, x: 0, duration: 0.3, ease: (p)=>1-Math.pow(2,-10*p*0.3/0.12), stagger: 0.09 }, F(277));
      tl.to("#g-rowwrap,#g-icon", { autoAlpha: 0, duration: F(272)-F(266), ease: "power1.in" }, F(266));
      /* group rises (nudge) */
      gsap.set("#h-rows", { scale: 0.72 });
      tl.to("#h-rows", { scale: 1, duration: F(308)-F(296), ease: "power2.inOut" }, F(296));
      tl.to("#h-rows", { x: 59, y: -89, duration: F(335)-F(308), ease: "none" }, F(308));
      /* rows exit upward, staggered, accelerating */
      [[0,313],[1,319],[2,323],[3,326]].forEach(([i, f]) => {
        tl.to(`#hr${i}`, { y: -460, duration: 0.42, ease: "power2.in" }, F(f));
        tl.to(`#hr${i}`, { filter: "blur(6px)", duration: 0.42, ease: "power2.in" }, F(f));
        tl.to(`#hr${i}`, { autoAlpha: 0, duration: 0.25, ease: "power1.in" }, F(f + 4));
      });

      /* ---- I : Keep listening ---- */
      gsap.set("#i-group", { autoAlpha: 0, y: 96 });
      gsap.set("#i-listen", { autoAlpha: 0 });
      gsap.set("#i-caret", { autoAlpha: 0 });
      gsap.set("#i-sel", { scaleX: 0 });
      gsap.set(".ihandle,.ihstem", { autoAlpha: 0 });
      tl.to("#i-group", { autoAlpha: 1, duration: 0.5, ease: "power1.out" }, F(335));
      tl.to("#i-group", { y: 0, duration: 0.9, ease: (p)=>1-Math.pow(2,-10*p*0.9/0.35) }, F(335));
      tl.fromTo("#i-group", { filter: "blur(4px)" }, { filter: "blur(0px)", duration: 0.35, ease: "power2.out" }, F(335));
      tl.to("#i-caret", { autoAlpha: 1, duration: 0.12, ease: "none" }, F(340));
      /* listening ghost-fades in (light gray → ink via opacity) */
      tl.to("#i-listen", { autoAlpha: 1, duration: F(349)-F(342), ease: "power1.inOut" }, F(342));
      /* selection sweeps L→R */
      tl.to("#i-sel", { scaleX: 1, duration: F(355.5)-F(350), ease: "power1.inOut" }, F(350));
      tl.to(".ihandle,.ihstem", { autoAlpha: 1, duration: 0.15, ease: "power1.out" }, F(354));
      tl.to("#i-caret", { autoAlpha: 0, duration: 0.1, ease: "none" }, F(351));
      /* settle drift to dead center, hold */
      tl.to("#i-group", { y: -2, duration: 0.8, ease: "power1.out" }, F(356));

      /* master clock pad — timeline must span the full clip */
      tl.set({}, {}, 12.8333);

      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
