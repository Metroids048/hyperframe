:root {
  --ink: #f7fbff;
  --cyan: #06e3fa;
  --green: #4fdb5e;
  --violet: #a78bfa;
  --night: #05070a;
}

* { box-sizing: border-box; }

html,
body {
  width: 1920px;
  height: 1080px;
  margin: 0;
  overflow: hidden;
  background: var(--night);
  color: var(--ink);
  font-family: Inter, sans-serif;
}

#root {
  position: relative;
  width: 1920px;
  height: 1080px;
  overflow: hidden;
  isolation: isolate;
  background: var(--night);
}

.source-media {
  position: absolute;
  left: 0;
  top: 0;
  width: 4px;
  height: 4px;
  opacity: 0;
  pointer-events: none;
  z-index: -20;
}

.liquid-canvas,
.shader-layer {
  position: absolute;
  inset: 0;
  width: 1920px;
  height: 1080px;
}

.liquid-canvas {
  display: block;
  z-index: 1;
}

.shader-layer {
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
}

.frame-rule {
  position: absolute;
  background: rgba(247, 251, 255, 0.2);
}

.frame-rule.top,
.frame-rule.bottom {
  left: 72px;
  right: 72px;
  height: 2px;
}

.frame-rule.top { top: 64px; }
.frame-rule.bottom { bottom: 64px; }

.frame-rule.left,
.frame-rule.right {
  top: 64px;
  bottom: 64px;
  width: 2px;
}

.frame-rule.left { left: 72px; }
.frame-rule.right { right: 72px; }

.meta {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 18px;
  font-family: "JetBrains Mono", monospace;
  font-size: 18px;
  letter-spacing: 0.14em;
  line-height: 1;
  text-transform: uppercase;
  color: rgba(247, 251, 255, 0.72);
  white-space: nowrap;
}

.meta::before {
  content: "";
  display: block;
  width: 38px;
  height: 4px;
  background: var(--cyan);
  box-shadow: 0 0 24px rgba(6, 227, 250, 0.8);
}

.meta.top-left { left: 104px; top: 94px; }
.meta.bottom-right { right: 104px; bottom: 96px; }
.meta.bottom-right::before { background: var(--green); }

.optic-readout {
  position: absolute;
  right: 104px;
  top: 94px;
  display: grid;
  grid-template-columns: auto auto;
  gap: 8px 24px;
  font-family: "JetBrains Mono", monospace;
  font-size: 17px;
  line-height: 1.25;
  letter-spacing: 0.08em;
  color: rgba(247, 251, 255, 0.58);
}

.optic-readout b {
  color: rgba(247, 251, 255, 0.9);
  font-weight: 500;
  text-align: right;
}

.scanline {
  position: absolute;
  left: -420px;
  top: 62px;
  width: 260px;
  height: 956px;
  opacity: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(6, 227, 250, 0.035) 66%, rgba(6, 227, 250, 0.26) 100%);
  border-right: 2px solid rgba(6, 227, 250, 0.66);
  box-shadow: 34px 0 80px rgba(6, 227, 250, 0.11);
}

.terminal-lockup {
  position: absolute;
  left: 50%;
  bottom: 112px;
  min-width: 460px;
  padding: 20px 32px 18px;
  border: 2px solid rgba(247, 251, 255, 0.45);
  border-radius: 999px;
  background: rgba(5, 7, 10, 0.72);
  box-shadow: 0 18px 70px rgba(0, 0, 0, 0.42), inset 0 0 30px rgba(6, 227, 250, 0.04);
  text-align: center;
  font-size: 23px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  transform: translateX(-50%);
  opacity: 0;
}

.terminal-lockup span {
  color: var(--cyan);
}

.grain {
  position: absolute;
  inset: 0;
  opacity: 0.11;
  background-image:
    repeating-linear-gradient(0deg, rgba(255,255,255,0.018) 0 1px, transparent 1px 4px),
    repeating-linear-gradient(90deg, rgba(255,255,255,0.012) 0 1px, transparent 1px 5px);
  mix-blend-mode: screen;
}
