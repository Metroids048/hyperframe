<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HyperFrames Creative Studio</title><style>:root{--bg:#0d0f12;--panel:#171a20;--line:#303642;--text:#f5f7f8;--muted:#9ca6b3;--accent:#e4b66e}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,'Microsoft YaHei',sans-serif;padding:28px}h1{font-size:38px;margin:0 0 6px}.sub,.hint{color:var(--muted)}.layout{display:grid;grid-template-columns:360px 1fr;gap:26px;max-width:1320px;margin:24px auto}.panel,.sample{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:18px}.panel{display:flex;flex-direction:column;gap:12px}label{color:var(--muted);font-size:13px;display:grid;gap:6px}input,textarea,select{width:100%;background:#0f1116;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:11px;font:inherit}textarea{min-height:110px;resize:vertical}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.run{background:var(--accent);color:#17130d;border:0;border-radius:8px;padding:12px;font-weight:700;cursor:pointer}.run:disabled{opacity:.5}.status{min-height:22px;color:var(--muted)}.result video{width:100%;max-height:68vh;background:#000;border-radius:12px}.samples{display:grid;grid-template-columns:repeat(2,minmax(220px,1fr));gap:14px}.sample h3{margin:0 0 8px;font-size:16px}.sample video{width:100%;aspect-ratio:16/9;background:#000;border-radius:8px}.sample a{color:var(--accent);font-size:13px}.section-title{display:flex;justify-content:space-between;align-items:baseline}@media(max-width:800px){body{padding:18px}.layout{display:flex;flex-direction:column}.samples{grid-template-columns:1fr}}</style></head><body><h1>HyperFrames Creative Studio</h1><p class="sub">Brief → storyboard → native HTML composition → frame-accurate render</p><div class="layout"><form class="panel" id="creative-form"><label>创作模式<select name="creativeMode"><option value="text">Text → Motion</option><option value="image">Images → Motion Promo</option><option value="video">Videos → Product Promo</option><option value="mixed">Mixed → Full Ad</option></select></label><label>Creative brief<textarea name="message">MAKE IDEAS MOVE — editorial kinetic motion promo</textarea></label><div class="row"><label>Product<input name="productName" value="NOVA"></label><label>Style<select name="style"><option value="premium">Premium</option><option value="functional">Functional</option><option value="promotion">Promotion</option></select></label></div><label>卖点（用 / 分隔）<input name="facts" value="清晰表达 / 有节奏的动效 / 可继续编辑"></label><label>CTA<input name="cta" value="了解更多"></label><div class="row"><label>时长（秒）<input name="duration" type="number" min="5" max="60" value="15"></label><label>素材<input name="images" type="file" multiple accept="image/*,video/*"></label></div><button class="run" type="submit">Run Creative Pipeline</button><div class="status" id="status">保留四类输入与样例；上传素材后即可手动测试。</div></form><section><div class="section-title"><h2>Result</h2><span class="hint">Native composition preview</span></div><div class="result" id="result"><p class="hint">生成结果会出现在这里。</p></div><h2>Samples</h2><div class="samples" id="samples"></div></section></div><script>const demos=[['Text → Motion','text-demo'],['Images → Motion Promo','image-demo'],['Videos → Product Promo','video-demo'],['Mixed → Full Ad','mixed-demo']];document.querySelector('#samples').innerHTML=demos.map(([t,n])=>`<article class="sample"><h3>${t}</h3><video controls preload="metadata" src="/creative-v2/${n}/final.mp4"></video><a href="/creative-v2/${n}/final.mp4" target="_blank">Open MP4</a></article>`).join('');const form=document.querySelector('#creative-form'),status=document.querySelector('#status'),result=document.querySelector('#result');form.addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(form);const files=form.querySelector('[name=images]').files;if(!files.length&&fd.get('creativeMode')!=='text'){status.textContent='图片/视频模式请至少上传一份素材。';return}status.textContent='正在编排原生场景…';form.querySelector('.run').disabled=true;try{const r=await fetch('/api/commerce-chat',{method:'POST',body:fd});const j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'生成失败');const id=j.result?.projectId||j.result?.document?.projectId;const video=id?`/api/commerce/${id}/video`:'';result.innerHTML=`<video controls autoplay src="${video}"></video><p class="hint">已生成可编辑 native project。可在工作台继续修改。</p>`;status.textContent='完成';}catch(err){status.textContent=err.message;}finally{form.querySelector('.run').disabled=false;}});</script></body></html>

