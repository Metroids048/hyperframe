{"source":{"html":"<div id=\"scene03-root\"><div id=\"scene03-bg\"></div><img id=\"scene03-main\"/><div id=\"scene03-detail-frame\"><img id=\"scene03-detail\"/></div><div id=\"scene03-label\"></div></div>","css":"#scene03-root{position:relative;width:1080px;height:1920px;overflow:hidden;color:var(--brand-foreground);font-family:Microsoft YaHei,Arial;}#scene03-bg{position:absolute;inset:0;background-color:var(--brand-background);z-index:0;}#scene03-main{position:absolute;left:0px;top:370px;width:1080px;height:608px;object-fit:contain;z-index:1;}#scene03-detail-frame{position:absolute;left:96px;top:1060px;width:888px;height:420px;overflow:hidden;border:1px solid var(--brand-accent);border-radius:18px;background-color:var(--brand-panel);z-index:2;}#scene03-detail{position:absolute;left:0px;top:-295px;width:1244px;height:700px;object-fit:fill;}#scene03-label{position:absolute;left:96px;top:240px;padding:16px 22px;background-color:rgba(21,28,34,0.82);color:var(--brand-foreground);border:1px solid var(--brand-accent);border-radius:18px;font-size:34px;font-weight:400;line-height:1.2;white-space:nowrap;z-index:3;}","timeline":"","parameters":[],"objects":[{"elementId":"scene03-main","ref":"media-1"},{"elementId":"scene03-detail","ref":"media-1"},{"elementId":"scene03-label","ref":"text-1"}],"motionTargets":[],"textStyles":[{"elementId":"scene03-label","match":"侧面轮廓","fontSize":34,"fontWeight":400,"color":"#F4F7FA"}]},"notes":"修复图片映射：两个空 img 直接绑定真实素材，由应用注入。主视图保留完整画面，下方局部视图突出键帽与侧面。静态素材无时序差异，选择1.4秒；未执行编译或预览验证。","keyframeAtSeconds":1.4}