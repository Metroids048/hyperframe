<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=720, height=1280" />
    <title>hg-generate-reel (HeyGen)</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @font-face { font-family: "HGSans"; src: url("assets/fonts/TTNormsPro-Regular.woff2") format("woff2"); font-weight: 400; font-display: block; }
      @font-face { font-family: "HGSans"; src: url("assets/fonts/TTNormsPro-Medium.woff2") format("woff2"); font-weight: 500; font-display: block; }
      @font-face { font-family: "HGSans"; src: url("assets/fonts/TTNormsPro-SemiBold.woff2") format("woff2"); font-weight: 600; font-display: block; }
      @font-face { font-family: "HGSans"; src: url("assets/fonts/TTNormsPro-Bold.woff2") format("woff2"); font-weight: 700; font-display: block; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 720px; height: 1280px; overflow: hidden; background: #d8d5d9; }
      body {
        font-family: "HGSans", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
        font-kerning: none;
        -webkit-font-smoothing: antialiased;
      }
      #root { position: relative; width: 720px; height: 1280px; background: #d8d5d9; }
      #stage {
        position: absolute; inset: 0; overflow: hidden;
        background: radial-gradient(ellipse 62% 46% at 50% 50%,
          #efecef 0%, #e6e3e6 38%, #d8d5d9 66%, #bcb9bd 92%, #b2afb3 100%);
      }

      /* ---------- B1: text-selection intro ---------- */
      #introGroup { position: absolute; left: 360px; top: 637px; width: 0; height: 0; }
      /* selection band grows rightward from the caret anchor */
      #selWrap {
        position: absolute; left: -111px; top: -33px; height: 66px; width: 0;
        overflow: hidden; background: #b9eafd;
      }
      #selText {
        position: absolute; left: 6px; top: 5px;
        font-size: 45px; font-weight: 400; color: #0b0b0d; white-space: nowrap;
        letter-spacing: -0.5px;
      }
      .lolli { position: absolute; width: 34px; height: 100px; }
      .lolli .stem { position: absolute; left: 15px; width: 4px; height: 68px; background: #00c3ff; border-radius: 2px; }
      .lolli .knob { position: absolute; left: 3px; width: 28px; height: 28px; background: #00c3ff; border-radius: 50%; }
      #handleL .knob { top: 0; } #handleL .stem { top: 20px; }
      #handleR .knob { bottom: 0; } #handleR .stem { bottom: 20px; }
      #handleL { left: -128px; top: -52px; }
      #handleR { left: -128px; top: -46px; }

      /* carrier dot (intro + outro) */
      .bluedot { position: absolute; width: 17px; height: 17px; border-radius: 50%; background: #00c3ff; }
      #dotA { left: 351.5px; top: 628.5px; }
      #dotB { left: 424px; top: 417px; }

      /* ---------- B2/B3/B4: button -> capsule -> card (ONE node) ---------- */
      #panel {
        position: absolute; left: 360px; top: 637px; width: 160px; height: 160px;
        transform: translate(-50%, -50%);
        background: #00c3ff; /* HeyGen submit button; tweens to white glass at the stretch */
        backdrop-filter: blur(14px) saturate(160%);
        -webkit-backdrop-filter: blur(14px) saturate(160%);
        border: 1.5px solid rgba(255, 255, 255, 0.85);
        border-radius: 80px;
        overflow: hidden;
        box-shadow: 0 26px 60px rgba(60,58,64,0.28), 0 4px 14px rgba(60,58,64,0.10),
          inset 0 3px 10px rgba(255,255,255,0.95), inset 0 -10px 22px rgba(60,58,64,0.06),
          inset 2px 0 6px rgba(255,255,255,0.5);
      }
      #panelSheen {
        position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
        background:
          radial-gradient(120% 70% at 22% 8%, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0) 45%),
          radial-gradient(90% 45% at 50% 108%, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0) 55%);
      }
      #panelGlow {
        position: absolute; left: 360px; top: 637px; width: 340px; height: 340px;
        transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none;
        background: radial-gradient(circle, rgba(255,255,255,0.78) 0%, rgba(255,255,255,0) 68%);
      }
      #arrowIcon {
        position: absolute; left: 50%; top: 50%; width: 80px; height: 80px;
        transform: translate(-50%, -50%);
      }
      #ripple {
        position: absolute; left: 360px; top: 637px; width: 190px; height: 190px;
        transform: translate(-50%, -50%); border-radius: 50%;
        border: 3px solid rgba(255,255,255,0.95); pointer-events: none;
      }
      #cardContent { position: absolute; inset: 0; }
      #genTitle {
        position: absolute; left: 0; top: 96px; width: 100%; text-align: center;
        font-size: 47px; font-weight: 600; letter-spacing: -0.3px; color: #0b0b0d;
      }
      .scaleLbl { position: absolute; top: 228px; font-size: 33px; font-weight: 400; color: #0b0b0d; }
      #lbl0 { left: 68px; } #lbl50 { left: 220px; } #lbl100 { left: 368px; }
      #batWrap { position: absolute; left: 50%; top: 74.6%; width: 440px; height: 170px; }
      #batSvg { display: block; width: 100%; height: 100%; overflow: visible; }

      /* grip cursor: a CHILD of the card — mechanically locked to its pickup spot */
      #cursorGrip {
        position: absolute; left: 177px; top: 21px; width: 96px; height: 110px;
        filter: drop-shadow(0 5px 7px rgba(0,0,0,0.28));
        pointer-events: none; z-index: 5;
      }

      /* ---------- cursor ---------- */
      #cursor, #cursor2 {
        position: absolute; left: 0; top: 0; width: 96px; height: 110px;
        filter: drop-shadow(0 5px 7px rgba(0,0,0,0.28));
        pointer-events: none; will-change: transform; z-index: 40;
      }

      /* ---------- B5/B6: card folder ---------- */
      #folderGroup { position: absolute; left: 360px; top: 660px; width: 0; height: 0; }
      #folderBack {
        position: absolute; left: -245px; top: -202px; width: 490px; height: 290px;
        background: #0092cc; border-radius: 40px;
      }
      #folderFront {
        position: absolute; left: -250px; top: -160px; width: 500px; height: 348px;
        background: #8fdcff; border-radius: 44px;
        box-shadow: 0 26px 50px rgba(50,60,70,0.28);
        z-index: 5; /* the pocket: cards live BEHIND the flap until one leaves */
      }
      /* rotation lives on the wrapper (fixed pose); the card slides along its own
         tilted axis INSIDE the wrapper — the card bottoms stay inside the pocket */
      .fslot { position: absolute; width: 0; height: 0; }
      #slotA   { left: -50px;  top: -80px; transform: rotate(-36deg); z-index: 3; }
      #slotB { left: 35px;   top: -95px; transform: rotate(-16deg); z-index: 2; }
      #slotC   { left: 145px;  top: -85px; transform: rotate(14deg);  z-index: 1; }
      .fcard { position: absolute; border-radius: 24px; }
      #cardA {
        left: -132px; top: -185px; width: 265px; height: 370px;
        background: #050505;
        box-shadow: 0 18px 40px rgba(0,0,0,0.35);
      }
      #cardB { left: -120px; top: -170px; width: 240px; height: 340px; background: #00c3ff; box-shadow: 0 12px 30px rgba(0,0,0,0.2); }
      #cardC  { left: -120px; top: -170px; width: 240px; height: 340px; background: #fbfbfd; box-shadow: 0 12px 30px rgba(0,0,0,0.2); }
      .cardInner { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; }
      .cardInner video { width: 100%; height: 100%; object-fit: cover; display: block; }
      #folderTitle {
        position: absolute; left: -250px; top: 216px; width: 500px; text-align: center;
        font-size: 40px; font-weight: 600; letter-spacing: -0.4px; color: #10121a;
      }
      #trRow {
        position: absolute; left: 18px; top: 14px; width: 340px;
        display: flex; align-items: center; gap: 10px;
        transform-origin: 0 0;
      }
      #trRow svg { width: 34px; height: 34px; flex: none; }
      #trText { font-size: 23px; font-weight: 700; letter-spacing: 2.5px; color: #fff; white-space: nowrap; }
      #markB {
        position: absolute; left: 78%; top: 11%;
        transform: translate(-50%, -50%) rotate(-90deg);
        font-size: 52px; font-weight: 700; color: #163300; letter-spacing: -1px;
        display: flex; align-items: center; gap: 6px;
      }
      #ppMark {
        position: absolute; left: 66%; top: 10%;
        transform: translate(-50%, -50%) rotate(-90deg);
        font-size: 44px; font-weight: 800; font-style: italic;
        display: flex; align-items: center; gap: 8px; white-space: nowrap;
      }
      #ppMark .p1 { color: #003087; } #ppMark .p2 { color: #0079c1; }

      .clip { visibility: hidden; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="hg-generate-reel" data-width="720" data-height="1280" data-start="0" data-duration="11.79">
      <div id="stage" class="clip" data-start="0" data-duration="11.79" data-track-index="0">

        <!-- B1 text-selection intro -->
        <div id="introGroup">
          <div id="selWrap"><div id="selText">Make a video</div></div>
          <div id="handleL" class="lolli"><div class="knob"></div><div class="stem"></div></div>
          <div id="handleR" class="lolli"><div class="stem"></div><div class="knob"></div></div>
        </div>
        <div id="dotA" class="bluedot"></div>

        <!-- B2-B4 morphing panel -->
        <div id="panelGlow"></div>
        <div id="ripple"></div>
        <div id="panel">
          <div id="panelSheen"></div>
          <svg id="arrowIcon" viewBox="5 -46 39 48" aria-hidden="true"><path d="M8.416015625 -23.734375Q7.38671875 -23.734375 6.720703125 -24.4306640625Q6.0546875 -25.126953125 6.0546875 -26.1259765625Q6.0546875 -27.0947265625 6.8115234375 -27.912109375L22.40234375 -43.533203125Q23.189453125 -44.380859375 24.21875 -44.380859375Q25.248046875 -44.380859375 26.03515625 -43.533203125L41.6259765625 -27.912109375Q42.3828125 -27.0947265625 42.3828125 -26.1259765625Q42.3828125 -25.126953125 41.716796875 -24.4306640625Q41.05078125 -23.734375 40.021484375 -23.734375Q39.537109375 -23.734375 39.0830078125 -23.916015625Q38.62890625 -24.09765625 38.326171875 -24.400390625L33.9970703125 -28.6083984375L24.1884765625 -39.416015625L14.4404296875 -28.6083984375L10.111328125 -24.400390625Q9.80859375 -24.09765625 9.3544921875 -23.916015625Q8.900390625 -23.734375 8.416015625 -23.734375ZM24.21875 0.6962890625Q23.1591796875 0.6962890625 22.462890625 0.01513671875Q21.7666015625 -0.666015625 21.7666015625 -1.7255859375V-31.908203125L22.0693359375 -39.35546875Q22.0693359375 -40.32421875 22.65966796875 -40.91455078125Q23.25 -41.5048828125 24.21875 -41.5048828125Q25.1875 -41.5048828125 25.77783203125 -40.91455078125Q26.3681640625 -40.32421875 26.3681640625 -39.35546875L26.6708984375 -31.908203125V-1.7255859375Q26.6708984375 -0.666015625 25.974609375 0.01513671875Q25.2783203125 0.6962890625 24.21875 0.6962890625Z" fill="#ffffff"/></svg>
          <div id="cardContent">
            <div id="genTitle">Generating.</div>
            <div id="lbl0" class="scaleLbl">0</div>
            <div id="lbl50" class="scaleLbl">50</div>
            <div id="lbl100" class="scaleLbl">100</div>
            <div id="batWrap">
              <svg id="batSvg" viewBox="0 0 440 170">
                <defs>
                  <clipPath id="pillClip"><rect x="0" y="0" width="440" height="170" rx="85" ry="85"/></clipPath>
                  <radialGradient id="fillShade" cx="32%" cy="24%" r="95%">
                    <stop offset="0%" stop-color="rgba(255,255,255,0.10)"/>
                    <stop offset="60%" stop-color="rgba(255,255,255,0)"/>
                    <stop offset="100%" stop-color="rgba(0,0,0,0.10)"/>
                  </radialGradient>
                </defs>
                <g clip-path="url(#pillClip)">
                  <rect x="0" y="0" width="440" height="170" fill="#26232a"/>
                  <path id="fillPath" d="M -20 -10 L 20 -10 Q 8 85 20 180 L -20 180 Z" fill="#fe5800"/>
                  <rect x="0" y="0" width="440" height="170" fill="url(#fillShade)"/>
                </g>
              </svg>
            </div>
          </div>
        </div>

        <!-- B5/B6 card folder -->
        <div id="folderGroup">
          <div id="folderBack"></div>
          <div id="slotC" class="fslot"><div id="cardC" class="fcard"><div class="cardInner"><video id="cardVidC" class="clip" src="assets/card-gradient.mp4" muted playsinline data-start="7.2" data-duration="3.2" data-track-index="4"></video></div></div></div>
          <div id="slotB" class="fslot"><div id="cardB" class="fcard"><div class="cardInner"><video id="cardVidB" class="clip" src="assets/card-twitch.mp4" muted playsinline data-start="7.2" data-duration="3.2" data-track-index="3"></video></div></div></div>
          <div id="slotA" class="fslot"><div id="cardA" class="fcard">
          <svg id="cursorGrip" viewBox="0 0 96 110">
            <g stroke="#101010" stroke-width="4" stroke-linejoin="round" fill="#ffffff">
              <path d="M34 8 c0 -5 9 -5 9 0 l0 34 c0 2 3 2 3 0 l0 -8 c0 -5 9 -5 9 0 l0 9 c0 2 3 2 3 0 l0 -6 c0 -5 9 -5 9 0 l0 7 c0 2 3 2 3 0 l0 -3 c0 -5 8.6 -5 8.6 0 l0 26 c0 20 -12 32 -28 32 c-14 0 -21 -5 -27 -16 l-12 -22 c-3 -6 4 -11 9 -6 l4 4 c1.6 1.6 4 1 4 -1.6 z"/>
            </g>
          </svg>
          <div class="cardInner"><video id="cardVidA" class="clip" src="assets/card-beasty.mp4" muted playsinline data-start="7.2" data-duration="3.5" data-track-index="2"></video></div></div></div>
          <div id="folderFront"></div>
          <div id="folderTitle">Brand Videos</div>
        </div>

        <!-- outro dot -->
        <div id="dotB" class="bluedot"></div>

        <!-- cursors (one actor, two entries) -->
        <svg id="cursor" viewBox="0 0 96 110">
          <g stroke="#101010" stroke-width="4" stroke-linejoin="round" fill="#ffffff">
            <path d="M34 8 c0 -5 9 -5 9 0 l0 34 c0 2 3 2 3 0 l0 -8 c0 -5 9 -5 9 0 l0 9 c0 2 3 2 3 0 l0 -6 c0 -5 9 -5 9 0 l0 7 c0 2 3 2 3 0 l0 -3 c0 -5 8.6 -5 8.6 0 l0 26 c0 20 -12 32 -28 32 c-14 0 -21 -5 -27 -16 l-12 -22 c-3 -6 4 -11 9 -6 l4 4 c1.6 1.6 4 1 4 -1.6 z"/>
          </g>
        </svg>
        <svg id="cursor2" viewBox="0 0 96 110">
          <g stroke="#101010" stroke-width="4" stroke-linejoin="round" fill="#ffffff">
            <path d="M34 8 c0 -5 9 -5 9 0 l0 34 c0 2 3 2 3 0 l0 -8 c0 -5 9 -5 9 0 l0 9 c0 2 3 2 3 0 l0 -6 c0 -5 9 -5 9 0 l0 7 c0 2 3 2 3 0 l0 -3 c0 -5 8.6 -5 8.6 0 l0 26 c0 20 -12 32 -28 32 c-14 0 -21 -5 -27 -16 l-12 -22 c-3 -6 4 -11 9 -6 l4 4 c1.6 1.6 4 1 4 -1.6 z"/>
          </g>
        </svg>
      </div>

    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      window.__timelines["hg-generate-reel"] = tl;

      gsap.defaults({ overwrite: "auto" });

      /* ============ initial states ============ */
      gsap.set("#introGroup", { autoAlpha: 1, scale: 1, rotation: 0, transformOrigin: "0px 0px" });
      gsap.set("#selWrap", { width: 0 });
      gsap.set(["#handleL", "#handleR"], { scale: 0, transformOrigin: "50% 50%" });
      gsap.set("#handleR", { x: 0 });
      gsap.set("#dotA", { autoAlpha: 0, scale: 1, transformOrigin: "50% 50%" });
      gsap.set("#panel", { autoAlpha: 0, scale: 0.55, transformOrigin: "50% 50%" });
      gsap.set("#panelGlow", { autoAlpha: 0 });
      gsap.set("#ripple", { autoAlpha: 0, scale: 0.9 });
      gsap.set("#cardContent", { autoAlpha: 0 });
      gsap.set("#genTitle", { autoAlpha: 0, y: 10 });
      gsap.set(["#lbl0", "#lbl50", "#lbl100"], { autoAlpha: 0, y: -55 });
      gsap.set("#batWrap", { autoAlpha: 0, scale: 0.2, xPercent: -50, yPercent: -50, transformOrigin: "50% 50%" });
      gsap.set("#cursor", { x: 640, y: 360, scale: 0.45, rotation: -95, autoAlpha: 0,
        filter: "blur(5px)", transformOrigin: "40% 8%" });
      gsap.set("#cursor2", { x: 350, y: -220, autoAlpha: 0, transformOrigin: "40% 8%" });
      // the folder enters CCW-tilted, carrying the card's own rotation direction
      gsap.set("#folderGroup", { autoAlpha: 0, scale: 0.07, rotation: -22, transformOrigin: "0px 0px" });
      // cards tucked: rotation is fixed on the slot; the card slides along its own axis
      // tuck depth is capped so card bottoms never clear the flap (they stay IN the folder)
      gsap.set("#cardA", { y: 120 });
      gsap.set("#cardB", { y: 115 });
      gsap.set("#cardC", { y: 100 });
      gsap.set(["#slotA", "#slotB", "#slotC"], { transformOrigin: "0px 0px" });
      gsap.set("#dotB", { autoAlpha: 0 });
      gsap.set("#trRow", { rotation: 0 });
      // grip cursor counter-rotated so the hand reads upright despite the card's -36
      gsap.set("#cursorGrip", { autoAlpha: 0, rotation: 36, transformOrigin: "40% 8%" });

      /* ============ B1 — text-selection intro (0 - 1.83) ============ */
      // caret pops in: both lollipops overlapped read as one dumbbell caret
      tl.to(["#handleL", "#handleR"], { scale: 1, duration: 0.30, ease: "back.out(1.5)" }, 0.07);
      // type-on: selection band + right handle sweep rightward in character steps
      // 252 = Inter 45px "Apple Style" ink (~240) + padding — the trailing "e" must never clip
      const TYPE_T = 0.60, TYPE_D = 0.36, BAND_W = 274;
      tl.to("#selWrap", { width: BAND_W, duration: TYPE_D, ease: "steps(12)" }, TYPE_T);
      tl.to("#handleR", { x: BAND_W + 6, duration: TYPE_D, ease: "steps(12)" }, TYPE_T);
      // swell + settle
      tl.to("#introGroup", { scale: 1.055, duration: 0.38, ease: "power1.inOut" }, 1.0);
      // collapse back into the dot — still contracting at the swap (no settle)
      tl.to("#introGroup", { scale: 0.03, rotation: 28, duration: 0.40, ease: "power2.in" }, 1.40);
      tl.set("#introGroup", { autoAlpha: 0 }, 1.80);
      tl.set("#dotA", { autoAlpha: 1 }, 1.77);

      /* ============ B2 — arrow button + cursor + click (1.83 - 3.73) ============ */
      // compression bounce: the collapse springs back as the button
      tl.to("#panel", { autoAlpha: 1, duration: 0.14, ease: "none" }, 1.83);
      tl.to("#panel", { scale: 1, duration: 0.45, ease: "power3.out" }, 1.83);
      tl.to("#panelGlow", { autoAlpha: 1, duration: 0.5, ease: "power2.out" }, 1.9);
      tl.to("#dotA", { autoAlpha: 0, duration: 0.12, ease: "none" }, 1.95);

      // the cursor comes OUT AND AROUND the button: ONE continuous flow —
      // a single eased progress driving a cubic bezier arc; rotation, scale and blur
      // all ride the same parameter (no segment boundaries)
      const arc = { t: 0 };
      const A0 = {x: 640, y: 360}, A1 = {x: 700, y: 660},
            A2 = {x: 520, y: 950}, A3 = {x: 324, y: 660};
      function arcPos() {
        const t = arc.t, u = 1 - t;
        const bx = u*u*u*A0.x + 3*u*u*t*A1.x + 3*u*t*t*A2.x + t*t*t*A3.x;
        const by = u*u*u*A0.y + 3*u*u*t*A1.y + 3*u*t*t*A2.y + t*t*t*A3.y;
        gsap.set("#cursor", { x: bx, y: by, rotation: -95 * u, scale: 0.45 + 0.55 * t,
          filter: "blur(" + (5 * Math.max(0, 1 - t * 2.2)).toFixed(2) + "px)" });
      }
      tl.set("#cursor", { autoAlpha: 1 }, 1.90);
      tl.to(arc, { t: 1, duration: 1.2, ease: "power2.out", onUpdate: arcPos }, 1.90);
      // then a clean hover hold until the click (stillness before the climax) —
      // no extra drift tween: it re-initialized under seek and read as a glitch

      // click at 3.5 — tap + button dip + ripple, same frame
      // NOTE: every #cursor tween after the arc uses an explicit fromTo anchor —
      // the arc writes via onUpdate, which the runtime's seek/prewarm suppresses,
      // so a plain .to() captures a STALE start on cold-seeking render workers
      tl.fromTo("#cursor", { scale: 1 },
        { scale: 0.85, duration: 0.10, ease: "power2.in", immediateRender: false }, 3.50);
      tl.to("#cursor", { scale: 1, duration: 0.20, ease: "power2.out" }, 3.60);
      tl.to("#panel", { scale: 0.94, duration: 0.10, ease: "power2.in" }, 3.50);
      tl.to("#panel", { scale: 1, duration: 0.22, ease: "power2.out" }, 3.60);
      tl.set("#ripple", { autoAlpha: 0.9, scale: 0.95 }, 3.50);
      tl.to("#ripple", { scale: 2.4, autoAlpha: 0, duration: 0.5, ease: "power2.out" }, 3.52);

      /* ============ B3 — button -> capsule -> card (3.73 - 4.93) ============ */
      tl.to("#arrowIcon", { autoAlpha: 0, duration: 0.15, ease: "none" }, 3.62);
      // vertical stretch (click ignition carries into growth); the cyan submit
      // button dissolves into the white glass as it grows
      tl.to("#panel", { height: 530, width: 165, borderRadius: 84, duration: 0.70, ease: "power2.inOut" }, 3.73);
      tl.to("#panel", { backgroundColor: "rgba(255,253,255,0.66)", duration: 0.55, ease: "power2.inOut" }, 3.73);
      // widen into the card — width picks up while height still settling (keyframe overlap)
      tl.to("#panel", { width: 500, height: 500, borderRadius: 90, duration: 0.52, ease: "power3.inOut" }, 4.43);
      tl.to("#panelGlow", { scale: 1.7, duration: 1.2, ease: "power2.out" }, 3.73);

      // cursor rides the stretch down, then detaches and FALLS (gravity + tumble + blur)
      tl.fromTo("#cursor", { x: 324, y: 660 },
        { x: 322, y: 780, duration: 0.7, ease: "power1.inOut", immediateRender: false }, 3.73);
      tl.to("#cursor", { y: 2050, duration: 0.5, ease: "power2.in" }, 4.60);
      tl.fromTo("#cursor", { rotation: 0 },
        { rotation: -110, duration: 0.5, ease: "power1.in", immediateRender: false }, 4.60);
      tl.fromTo("#cursor", { filter: "blur(0px)" },
        { filter: "blur(10px)", duration: 0.4, ease: "power2.in", immediateRender: false }, 4.65);

      // card content
      tl.to("#cardContent", { autoAlpha: 1, duration: 0.2, ease: "none" }, 4.50);
      tl.to("#genTitle", { autoAlpha: 1, y: 0, duration: 0.4, ease: "power3.out" }, 4.55);
      tl.to("#batWrap", { autoAlpha: 1, duration: 0.12, ease: "none" }, 4.43);
      // grows from the center of the glass, tracking the panel's own widening
      tl.to("#batWrap", { scale: 1, duration: 0.55, ease: "power1.inOut" }, 4.45);
      // labels drop in, staggered L->R
      // much bouncier drop-in (director round 4)
      tl.to("#lbl0",   { autoAlpha: 1, y: 0, duration: 0.50, ease: "back.out(2.6)" }, 4.70);
      tl.to("#lbl50",  { autoAlpha: 1, y: 0, duration: 0.50, ease: "back.out(2.6)" }, 4.82);
      tl.to("#lbl100", { autoAlpha: 1, y: 0, duration: 0.50, ease: "back.out(2.6)" }, 4.94);

      /* ============ B4 — the charge (5.0 - 6.83) ============ */
      const fillPath = document.getElementById("fillPath");
      const charge = { p: 0.06 };
      const stops = [
        [0.00, "#7559ff"], [0.45, "#7559ff"], [0.65, "#3b8bff"],
        [0.85, "#00c3ff"], [1.00, "#2fd8ff"]
      ];
      function colorAt(p) {
        for (let i = 1; i < stops.length; i++) {
          if (p <= stops[i][0]) {
            const t = (p - stops[i-1][0]) / (stops[i][0] - stops[i-1][0]);
            return gsap.utils.interpolate(stops[i-1][1], stops[i][1])(Math.max(0, Math.min(1, t)));
          }
        }
        return stops[stops.length - 1][1];
      }
      function drawFill() {
        const p = charge.p;
        const X = -20 + p * 500;                     // edge sweeps past the right cap at p=1
        const K = 26 * Math.min(1, (1 - p) * 3 + 0.15);  // meniscus relaxes as it tops out
        // fluid leading edge: traveling wobble, pure function of p (seek-safe),
        // amplitude peaks mid-fill; drawn as a C1-continuous catmull-rom spline —
        // fully curved, no straight segments or kinks
        const A = 9 * Math.pow(Math.sin(Math.PI * Math.min(Math.max(p, 0), 1)), 0.8);
        const ph = p * 13;
        const ys = [-10, 20, 55, 85, 115, 150, 180];
        const pts = ys.map(function (y) {
          const m = Math.sin(Math.PI * Math.min(Math.max((y + 10) / 190, 0), 1)); // 0 at caps
          const wob = A * m * Math.sin(ph + y * 0.022 + 0.8);   // long, gentle wave
          return [X - K * m + wob, y];
        });
        let d = "M -20 -10 L " + pts[0][0].toFixed(1) + " " + pts[0][1];
        for (let i = 0; i < pts.length - 1; i++) {
          const q0 = pts[Math.max(i - 1, 0)], q1 = pts[i],
                q2 = pts[i + 1], q3 = pts[Math.min(i + 2, pts.length - 1)];
          const c1x = q1[0] + (q2[0] - q0[0]) / 6, c1y = q1[1] + (q2[1] - q0[1]) / 6;
          const c2x = q2[0] - (q3[0] - q1[0]) / 6, c2y = q2[1] - (q3[1] - q1[1]) / 6;
          d += " C " + c1x.toFixed(1) + " " + c1y.toFixed(1) + " " +
               c2x.toFixed(1) + " " + c2y.toFixed(1) + " " +
               q2[0].toFixed(1) + " " + q2[1];
        }
        d += " L -20 180 Z";
        fillPath.setAttribute("d", d);
        fillPath.setAttribute("fill", colorAt(p));
      }
      drawFill();
      charge.p = 0.12;
      tl.to(charge, { p: 1, duration: 1.55, ease: "power1.inOut", onUpdate: drawFill }, 4.75);
      // reaction OVERLAPS the cause: the fill completes at 6.30, but the pill pulse
      // and the card swell both start ~100ms EARLIER, while the edge is still
      // closing — one connected gesture, not two sequential ones
      tl.to("#batWrap", { scale: 1.025, duration: 0.12, ease: "power2.out" }, 6.20);
      tl.to("#batWrap", { scale: 1, duration: 0.25, ease: "power2.out" }, 6.32);
      // ...and the swell CRESTS directly into the exit (overlapping handoff):
      // no settle-back, the scale-up peaks exactly at 6.83 and the shrink-spin
      // snaps out of it mid-motion
      tl.to("#panel", { scale: 1.045, duration: 0.18, ease: "power2.out" }, 6.20);
      tl.to("#panel", { scale: 1.10, duration: 0.45, ease: "power2.in" }, 6.38);

      /* ============ B5 — card shrink-swap -> folder (6.83 - 8.2) ============ */
      // exit spins RIGHT (CW) — the folder then enters -22 -> 0, same angular direction
      tl.to("#panel", { rotation: 16, scale: 0.05, duration: 0.40, ease: "power2.in" }, 6.83);
      tl.to("#panel", { filter: "blur(6px)", duration: 0.25, ease: "power2.in" }, 6.98);
      tl.set("#panel", { autoAlpha: 0 }, 7.2333);
      tl.set("#panelGlow", { autoAlpha: 0 }, 7.2333);

      // the folder springs out of the compression point (enters mid-flight, kick at 7.27),
      // un-rotating from -22 — same rotational direction the card exited with
      tl.set("#folderGroup", { autoAlpha: 1 }, 7.2333);
      tl.to("#folderGroup", { scale: 1, duration: 0.42, ease: "power3.out" }, 7.2333);
      tl.to("#folderGroup", { rotation: 0, duration: 0.50, ease: "power2.out" }, 7.2333);
      // cards slide up their own axes out of the pocket, staggered, small overshoot
      tl.to("#cardA",   { y: -75, duration: 0.60, ease: "back.out(1.3)" }, 7.30);
      tl.to("#cardB", { y: -55, duration: 0.60, ease: "back.out(1.3)" }, 7.40);
      tl.to("#cardC",   { y: -35, duration: 0.60, ease: "back.out(1.3)" }, 7.50);

      /* ============ B6 — grab + pull + whip exit (7.6 - 10.5) ============ */
      tl.set("#cursor2", { autoAlpha: 1 }, 7.60);
      tl.to("#cursor2", { y: 60, duration: 0.55, ease: "power3.out" }, 7.60);
      // approach ends exactly at the grip point's world position (computed)
      tl.to("#cursor2", { x: 204, y: 336, duration: 0.24, ease: "power2.inOut" }, 8.15);
      // press on the card corner
      tl.to("#cursor2", { scale: 0.87, duration: 0.1, ease: "power2.in" }, 8.40);
      tl.to("#cursor2", { scale: 1, duration: 0.2, ease: "power2.out" }, 8.50);
      // pickup: swap the free cursor for the card-locked grip cursor (same spot)
      tl.set("#cursor2", { autoAlpha: 0 }, 8.53);
      tl.set("#cursorGrip", { autoAlpha: 1 }, 8.53);

      // ONE continuous pull (director round 5): all the way to the screen edge and
      // out of the folder in a single motion — no mid-pull step; the grip cursor is
      // a child of the card, so it cannot drift from its pickup spot
      tl.to("#slotA", { x: 430, y: -150, rotation: 25, duration: 1.37, ease: "power1.inOut" }, 8.53);
      tl.to("#cardA", { y: -200, duration: 1.37, ease: "power1.inOut" }, 8.53);
      // counter-rotation keeps the locked hand upright while the card swings
      tl.to("#cursorGrip", { rotation: -25, duration: 1.37, ease: "power1.inOut" }, 8.53);
      tl.set("#slotA", { zIndex: 9 }, 9.75);
      tl.set("#cursorGrip", { autoAlpha: 0 }, 9.95);

      // whip: diagonally ACROSS the screen, top-right -> bottom-left, huge + blurred
      tl.to("#slotA", { x: -1500, y: 1500, rotation: 60, scale: 4.6, duration: 0.45, ease: "power2.in" }, 10.05);
      tl.to("#cardA", { filter: "blur(20px)", duration: 0.3, ease: "power1.in" }, 10.12);
      // the folder is removed in one hard cut while the giant blurred card covers it
      tl.set(["#folderBack", "#folderFront", "#slotB", "#slotC", "#folderTitle"], { autoAlpha: 0 }, 10.32);
      tl.set("#slotA", { autoAlpha: 0 }, 10.55);

      /* ============ B7 — outro dot (10.1 - 11.79) ============ */
      tl.set("#dotB", { autoAlpha: 1 }, 10.10);
      tl.to("#dotB", { x: -72, y: 214, duration: 0.55, ease: "power2.inOut" }, 10.50);
      // hold to end (loop-matches the intro dot)
      tl.set("#dotB", { autoAlpha: 1 }, 11.79);
    </script>
  </body>
</html>
