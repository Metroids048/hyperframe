    "scenes": [
      {
        "sceneId": "scene-01",
        "paragraphId": "p1",
        "newInformation": "完整横置卡体首先入眼，三个风扇的排布成为后续定位参照。",
        "visualDirection": "原创开场整体定位：保留完整横向商品和手部范围，商品为第一层，标题只占框外左上小区域，字幕独立在下。吸引点是完整实物和短暂真实动作，不加模拟旋转、速度线或运行效果。下镜接正面外壳时保持同一部位名语境。"
      },
      {
        "sceneId": "scene-02",
        "paragraphId": "p1",
        "newInformation": "将三个风扇的整体印象落实到风扇与外围外壳的包围关系。",
        "visualDirection": "沿用自然实拍取景，不再裁大。部位名及短说明放到媒体框外，采用一次遮罩显现后稳定留读；说明避开叶片、中心标识和上缘。与开场形成整体到局部的第一次解释性变化。"
      },
      {
        "sceneId": "scene-03",
        "paragraphId": "p2",
        "newInformation": "从风扇数量转向单个风扇的中心与叶片关系。",
        "visualDirection": "真实近景为主，说明栏缩短为两层文字，留出最大叶片观看面积。名称放在框外，不画环绕叶片的装饰圈，也不把拍摄运动解释为风扇工作。用原片不同风扇取景自然推进。"
      },
      {
        "sceneId": "scene-04",
        "paragraphId": "p2",
        "newInformation": "风扇边框、金色角标与外壳转角同时可见，为侧面观察建立过渡。",
        "visualDirection": "商品轮廓优先，文字置于独立说明栏，避免覆盖本就较暗的转角。保留真实明暗，不用闪光或夸张锐化制造不存在的细节；此处不指认接口，不描述散热效果。"
      },
      {
        "sceneId": "scene-05",
        "paragraphId": "p3",
        "newInformation": "说明长侧边与风扇正面相邻，避免后续侧面特写失去方位。",
        "visualDirection": "原创关系桥接布局：上方等比大媒体，下方窄说明区；以真实同框交界承担位置证据。标签顺序从正面到长侧边轻量切换，媒体持续播放且不变形。不画隐藏面、不加固定指示箭头，不称为连续翻转。"
      },
      {
        "sceneId": "scene-06",
        "paragraphId": "p3",
        "newInformation": "矩形连接座位于长侧边上缘，与下一个端部接口挡板分属不同表面。",
        "visualDirection": "持续侧面实拍占主要面积，框外说明栏与上镜同一字体、颜色和边距。先显示部位名，再随旁白显示连接座名称；不遮住上缘矩形插座。保持可读停留，不靠追加标签填满时间，不推断针数、规格或用途。"
      },
      {
        "sceneId": "scene-07",
        "paragraphId": "p4",
        "newInformation": "端部挡板的接口开口与旁侧栅格进入清楚视野，与长侧边连接座明确区分。",
        "visualDirection": "保持大幅实拍，端部标签从首帧直接出现且稳定，不消耗短窗口做入场动画。字幕准确跟随“端部，四个接口开口”，不另堆数量标记。保护全部开口和旁侧栅格，不指认接口类型，不冻结、不重复、不减速。"
      },
      {
        "sceneId": "scene-08",
        "paragraphId": "p5",
        "newInformation": "展示与风扇正面不同的背板表面，补足商品多面结构印象。",
        "visualDirection": "背板占主画面，说明放框外，保持开口及中央固定结构完整可见。仅描述线条和开口；不讲材质、散热、拆装或隐藏电路。自然保留画面中的姿态发展，文字不跟随商品旋转。"
      },
      {
        "sceneId": "scene-09",
        "paragraphId": "p5",
        "newInformation": "从背面返回侧边端角，为最终完整商品回顾提供空间衔接。",
        "visualDirection": "使用与关系桥接镜头一致的上下分区，媒体大、文字轻。当前部位文字变为青色，其他回顾信息暂不显示；不绘制看不到的接口位置。通过实拍边缘与下一镜完整轮廓的切换回收方位，而非靠装饰转场。"
      },
      {
        "sceneId": "scene-10",
        "paragraphId": "p5",
        "newInformation": "将已看过的局部名称归回同一完整显卡，完成空间认识。",
        "visualDirection": "仅借用一次显现后保持的资源方法：完整竖置显卡持续播放，框外回顾文字为次。标题先出现，旁白说到“对照”时再显示部位索引；索引表达观看顺序，不在当前正面视角上标注不可见端部。保留包装但不转录型号，不接Logo、价格或CTA。"
      }
    ]
  },
