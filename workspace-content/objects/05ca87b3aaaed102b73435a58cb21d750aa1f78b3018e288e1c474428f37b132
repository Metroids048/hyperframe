import puppeteer from 'puppeteer-core';
import fs from 'node:fs/promises';
const [url,tag]=process.argv.slice(2),out='outputs/scene-demos-phase2/S08';
const browser=await puppeteer.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true,args:['--no-sandbox']});
try{const page=await browser.newPage();await page.setViewport({width:1400,height:1000});await page.goto(url,{waitUntil:'networkidle2'});await page.waitForFunction(()=>{const p=document.querySelector('hyperframes-player');return p&&p.iframe?.contentDocument?.querySelector('[data-composition-id]');},{timeout:60000});await page.evaluate(()=>document.querySelector('hyperframes-player').seek(1.2));await new Promise(r=>setTimeout(r,1800));await page.screenshot({path:`${out}/${tag}.png`,fullPage:true});console.log(JSON.stringify({url,at:1.2,screenshot:`${out}/${tag}.png`}));}finally{await browser.close();}
