              "id": "product_detail",
              "version": "3.0.0",
              "hash": "217dc2643e1d3587b098086161a09644ec2445094a2c82750ccb837991ae9c2c",
              "rules": {
                "RESOURCE_PROFILE.json": {
                  "sourceKind": "video",
                  "subjectProtection": "high",
                  "motionNeed": "derived from evidence, explanation and user style",
                  "layoutNeed": "overview-to-detail with evidence-bound callouts",
                  "textAreaMaxRatio": 0.25,
                  "forbidden": [
                    "full-screen cards hiding product",
                    "unverified claims",
                    "stock substituted product",
                    "invented price or terms"
                  ],
                  "businessObjective": "用具体证据解释购买关注点",
                  "sceneSelectionPolicy": "C.5 Agent 与 HyperFrames 的分工及资源策略\n\nAgent 负责把“值得说的话”约束在证据内，决定是特写、放大、分屏还是局部提示。HyperFrames 负责可编辑的 callout、局部构图、文字层级和比较布局。\n\n优先 component、lower third、typography 和清晰的 detail composition。使用 comparison 类资源前，必须有可比较的两项资料；同一素材裁两次不能自动当成独立对照。使用测量图示前必须有已确认数值，不能为了好看编刻度。"
                },
                "EDITING_POLICY.md": "# EDITING_POLICY\n\nC.6 音频、字幕与后续修改\n\n旁白可以解释画面，但不能加入画面或资料不支持的性能。修改一个卖点说明只影响该说明及相关旁白；普通样式调整不重新合成声音。换背景音乐不应改掉已经核对的标注位置。\n\n修改示例：“把分区二提前，其他细节保留”“删掉容量说法，只留取物位置”“这根指示线指错了，指向拉链开口”。\n"
              }
            },
