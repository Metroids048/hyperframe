      #s5 #s5-scene{ position:absolute; inset:0; width:1080px; height:1080px;
    container-type:size; background:#F0EEE6; overflow:hidden; }
      #s5 #s5-scene *{ box-sizing:border-box; margin:0; padding:0; }
