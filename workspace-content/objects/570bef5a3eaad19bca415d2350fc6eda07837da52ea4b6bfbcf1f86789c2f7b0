<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>HyperFrames Creative Studio</title><style>body{margin:0;background:#0d0e12;color:#f5f5f5;font-family:system-ui;padding:28px}h1{font-size:40px}.sub{color:#9ca3af}.tabs{display:flex;gap:8px;margin:24px 0}.tabs button{background:#20232b;color:#fff;border:1px solid #343844;border-radius:9px;padding:11px 16px}.tabs button.active{background:#e4b66e;color:#111}.grid{display:grid;grid-template-columns:360px 1fr;gap:28px}.panel,.card{background:#171920;border:1px solid #292d38;border-radius:16px;padding:20px}.panel>*{width:100%;box-sizing:border-box;margin:8px 0}textarea,input{background:#0f1116;color:#fff;border:1px solid #363b48;border-radius:8px;padding:12px}.run{background:#e4b66e;border:0;border-radius:9px;padding:13px;font-weight:700}.samples{display:grid;grid-template-columns:repeat(2,minmax(220px,1fr));gap:16px}.card video{width:100%;aspect-ratio:9/16;background:#000}.card h3{margin:0 0 10px}</style></head><body><h1>HyperFrames Creative Studio</h1><p class=sub>输入理解 → storyboard → 原生 composition → 可播放结果</p><div class=tabs><button class=active>Text</button><button>Images</button><button>Videos</button><button>Mixed</button></div><div class=grid><form class=panel><input placeholder="Creative brief" value="MAKE IDEAS MOVE — editorial kinetic motion promo"><input type=file multiple accept="image/*,video/*"><textarea rows=5 placeholder="Describe mood, message, pacing and required scenes"></textarea><button class=run>Run Creative Pipeline</button><p class=sub>请求将进入现有对话生成与持续编辑流程。</p></form><section><h2>Samples</h2><div class=samples id=samples></div></section></div><script>const d=[['Text → Motion','text-demo'],['Images → Motion Promo','image-demo'],['Videos → Product Promo','video-demo'],['Mixed → Full Ad','mixed-demo']];samples.innerHTML=d.map(([t,n])=>`<article class=card><h3>${t}</h3><video controls preload=metadata src="/creative-v2/${n}/final.mp4"></video><p class=sub><a href="/creative-v2/${n}/final.mp4" target=_blank>Open MP4</a></p></article>`).join('')</script></body></html>
