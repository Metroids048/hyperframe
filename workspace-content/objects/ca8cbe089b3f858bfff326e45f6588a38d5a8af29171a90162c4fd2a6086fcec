              and trip `overlapping_gsap_tweens`. `q` (the move) and `k` (the release) are
              independent proxy channels composed in a single paint.
           2. The pull SPANS THE SEAM, and the seam is not on a frame boundary
              (15.6413 x 24 = 375.4), so S1's last frame is master 15.625 and S2's first is
              15.6667. A tween that merely "ends at the out-point" jumps backwards by a
              frame's worth of easing. Both sides evaluate the SAME pullEase over the SAME
              master-time window instead. */
        /* The pull window in MASTER time. It deliberately runs 0.86s PAST the cut, so the
           zoom-out lands at S2 local 0.859 — about when S2's own chrome finishes arriving
           (plan morph ends 0.92, canvas/player 0.60-1.20). It used to be 0.64s total and
           finished at S2 local 0.32, so the camera stopped and THEN the UI assembled: that
           is the "stepped" zoom-out Jake called out. Now the pull and the UI reveal are one
           continuous motion into the full UI.
           KEEP IN SYNC WITH s2-ui.html: PULL_T0, PULL_D and pullEase are duplicated there. */
        var PULL_T0 = 15.20, PULL_D = 1.30;
        function pullEase(u) {             /* power3.inOut, hand-written so S2 can share it */
          u = u < 0 ? 0 : u > 1 ? 1 : u;
          return u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;
        }
        var CAM = { q: 0, k: 0 };
        var camEl = document.getElementById("sq-cam");
        function paintCam() {
          var r = 1 - pullEase(CAM.k / PULL_D);   /* release: 1 = held in, 0 = identity */
          var a = CAM.q * r;                      /* ONE amount drives all three properties */
          /* x is -(scale-1)*84, i.e. derived FROM the scale, so the left edge is pinned by
             construction and the move can only ever be vertical + growth. */
          camEl.style.transform = "translate3d(" + (-0.48 * 118 * a).toFixed(3) + "px," +
            (-263.20 * a).toFixed(3) + "px,0) scale(" + (1 + 0.48 * a).toFixed(5) + ")";
        }
        paintCam();                        /* paint once at parse — an unset transform renders broken */

        /* the move in — cut-the-curve §7 nudge curve on the single `q` channel, because one
           built-in ease smacks to a stop. 10%/65%/25% of the distance over 20%/18%/62% of
           the time; the tail is 1.240s against a 0.400s ramp-in, past the 3x minimum.
           1.60s. It went 1.60 -> 2.00 on "you dont go long enough" and back to 1.60 on
           "a little bit faster" — but the TRAVEL stayed at the longer 263.2px/1.48 scale,
           which is the part that note was actually about. So this is 25% faster than the
           2.00s version over a 24% longer distance, i.e. meaningfully quicker than either
           earlier cut. Starts 12.80 — 25% into the accordion settle (12.62-13.32) — so the
           camera is already moving before the list stops. */
        tl.to(CAM, { q: 0.10, duration: 0.320, ease: "power3.in",  onUpdate: paintCam }, 12.80);
        tl.to(CAM, { q: 0.75, duration: 0.288, ease: "none",       onUpdate: paintCam }, 13.12);
        tl.to(CAM, { q: 1.00, duration: 0.992, ease: "power4.out", onUpdate: paintCam }, 13.408);

        /* 0.80s hold — the last check (14.853) and the shimmer (14.59-15.21) play inside
           it, so it is a loaded comma, not dead air. Then the pull: the direction change
           from push to pull is CAUSED by the plan completing. S1 renders the first 0.4413s
           of it; S2 renders the rest. */
        tl.to(CAM, { k: 15.6413 - PULL_T0, duration: 15.6413 - PULL_T0, ease: "none",
          onUpdate: paintCam }, PULL_T0);

        window.__timelines["sq"] = tl;
      })();
    </script>
  </div>
