# Copy to minimax.local.env. The filled local file is private and must never be committed or bundled.
# Fill only the API key below. Do not paste it into chat or an engineering report.
MINIMAX_API_KEY=
MINIMAX_REGION=cn
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_MUSIC_MODEL=music-2.6
# Preserve the existing engine until the key is filled; then select MiniMax.
MINIMAX_USE_FOR_SPEECH=true
# Voice IDs are discovered from your account, not invented here.
