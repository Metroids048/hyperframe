# Copy to edit.local.env. Existing environment variables take precedence.
# Default: use your existing ChatGPT login via Codex, with the CLI default model.
# VIDEO_AGENT_CODEX_BIN=codex
# VIDEO_AGENT_CODEX_MODEL=
# VIDEO_AGENT_PYTHON=C:/path/to/python.exe
# HYPERFRAMES_FFMPEG_PATH=C:/path/to/ffmpeg.exe
# HYPERFRAMES_FFPROBE_PATH=C:/path/to/ffprobe.exe
# HYPERFRAMES_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional separate API connection; never required for the default subscription route.
# VIDEO_AGENT_EDIT_PROVIDER=openai
# OPENAI_API_KEY=
# VIDEO_AGENT_EDIT_MODEL=
# VIDEO_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
