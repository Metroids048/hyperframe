{
  "version": 1,
  "categories": [
    "missing_evidence",
    "ambiguous_target",
    "unsupported_capability",
    "resource_incompatible",
    "provider_unavailable",
    "quality_failure",
    "revision_conflict"
  ],
  "maxReplans": 2,
  "identicalFailureLimit": 2,
  "preserveCurrentRevision": true,
  "allowSilentSubstitution": false,
  "steps": [
    "retry-same-capability",
    "safe-equivalent-execution",
    "retain-valid-revision",
    "report-failed-targets",
    "repair-only-gap"
  ],
  "classifiers": [
    [
      "revision_conflict",
      "REVISION_CONFLICT|STALE_REVISION"
    ],
    [
      "provider_unavailable",
      "^(MINIMAX_|CODEX_|PROVIDER_)"
    ],
    [
      "resource_incompatible",
      "RESOURCE_|INCOMPATIBLE"
    ],
    [
      "unsupported_capability",
      "UNSUPPORTED|CAPABILITY|VOICE_NOT_FOUND"
    ],
    [
      "ambiguous_target",
      "AMBIGUOUS|SCOPE|TARGET|CONFLICT|CAPTION_ALIGNMENT_REQUIRED"
    ],
    [
      "missing_evidence",
      "MISSING|NEEDS_INPUT|INSUFFICIENT|SPEECH_SCRIPT_REQUIRED|NO_SPEECH|NO_CAPTION_AUDIO"
    ]
  ]
}
