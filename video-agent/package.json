    "test:edit:presets": "node scripts/build-web.mjs && node scripts/test-preset-loading.mjs",
    "test:upgrade": "node scripts/test-upgrade-timeline.mjs && node scripts/test-upgrade-planner.mjs && node scripts/test-upgrade-service.mjs && node scripts/test-caption-translation.mjs && node scripts/test-edit-quality-evaluation.mjs",
    "test:upgrade:ui": "node scripts/build-web.mjs && node scripts/test-editor-upgrade-ui.mjs",
    "test:upgrade:media": "node scripts/test-upgrade-media.mjs && node scripts/test-upgrade-edge-media.mjs && node scripts/test-upgrade-loudness.mjs",
    "test:upgrade:generation": "node scripts/test-upgrade-generation.mjs",
    "test:upgrade:live": "node scripts/test-upgrade-live.mjs",
