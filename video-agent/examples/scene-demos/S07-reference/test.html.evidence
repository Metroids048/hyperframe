<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><style>@font-face{font-family:"PingFang SC";src:local("PingFang SC");}*{box-sizing:border-box}body{margin:0;background:#171717;font-family:"PingFang SC",sans-serif;color:white}[data-composition-id]{position:relative;width:1920px;height:1080px;overflow:hidden;background:#171717}.footage{position:absolute;left:160px;top:16px;width:1600px;height:900px;object-fit:contain}.chapter-host{position:absolute;inset:0;width:1920px;height:1080px;pointer-events:none}.chapter{position:absolute;left:0;top:930px;width:1920px;height:150px;display:flex;align-items:center;gap:32px;padding:0 160px 20px;background:transparent}.number{color:#D9C85A;font-family:monospace;font-size:70px;border-right:2px solid #D9C85A;padding-right:30px}.title{font-size:44px;font-weight:600;line-height:1.4}.detail{font-size:26px;color:#d6d6d6;line-height:1.6}.tag{margin-left:auto;font-size:24px;line-height:1.7;text-align:right;color:#D9C85A}.progress{position:absolute;bottom:0;left:0;width:1920px;height:5px;background:#D9C85A;transform-origin:left center}</style></head><body><div id="root" data-composition-id="s07-demo" data-width="1920" data-height="1080" data-start="0" data-duration="2" data-fps="30"><video id="v0" class="clip footage" src="assets/source.webm" muted playsinline data-start="0" data-duration="2" data-media-start="0" data-track-index="0"></video><audio id="a0" src="assets/source.webm" data-start="0" data-duration="2" data-media-start="0" data-volume="1" data-track-index="1"></audio><div id="c0" class="clip chapter-host" data-start="0" data-duration="2" data-track-index="2"><div class="chapter"><span class="number">01</span><div><div class="title">初始操作</div><div class="detail">双手接触 → 单手握持</div></div><span class="tag">过程记录精剪<br>原速 · 原声</span></div></div><div id="c1" class="clip chapter-host" data-start="12" data-duration="20" data-track-index="2"><div class="chapter"><span class="number">02</span><div><div class="title">握姿变化</div><div class="detail">保留手背转向与重新露出的过程</div></div><span class="tag">过程记录精剪<br>原速 · 原声</span></div></div><div id="c2" class="clip chapter-host" data-start="32" data-duration="9" data-track-index="2"><div class="chapter"><span class="number">03</span><div><div class="title">展开与收拢</div><div class="detail">保留托持状态的变化</div></div><span class="tag">过程记录精剪<br>原速 · 原声</span></div></div><div id="c3" class="clip chapter-host" data-start="41" data-duration="14" data-track-index="2"><div class="chapter"><span class="number">04</span><div><div class="title">末段展示</div><div class="detail">按原片顺序收尾</div></div><span class="tag">过程记录精剪<br>原速 · 原声</span></div></div><div class="progress" id="progress"></div></div><script src="assets/gsap.min.js"></script><script>window.__timelines=window.__timelines||{};const tl=gsap.timeline({paused:true});tl.from("#c0 .number",{opacity:0,x:-12,duration:.35,ease:"power3.out"},0.12);tl.from("#c0 .title",{opacity:0,y:12,duration:.4,ease:"power2.out"},0.18);tl.from("#c0 .detail",{opacity:0,y:8,duration:.45,ease:"sine.out"},0.24);tl.from("#c0 .tag",{opacity:0,duration:.4},0.2);tl.from("#c1 .number",{opacity:0,x:-12,duration:.35,ease:"power3.out"},12.12);tl.from("#c1 .title",{opacity:0,y:12,duration:.4,ease:"power2.out"},12.18);tl.from("#c1 .detail",{opacity:0,y:8,duration:.45,ease:"sine.out"},12.24);tl.from("#c1 .tag",{opacity:0,duration:.4},12.2);tl.from("#v1",{opacity:0,duration:.10,ease:"none"},12);tl.from("#c2 .number",{opacity:0,x:-12,duration:.35,ease:"power3.out"},32.12);tl.from("#c2 .title",{opacity:0,y:12,duration:.4,ease:"power2.out"},32.18);tl.from("#c2 .detail",{opacity:0,y:8,duration:.45,ease:"sine.out"},32.24);tl.from("#c2 .tag",{opacity:0,duration:.4},32.2);tl.from("#v2",{opacity:0,duration:.10,ease:"none"},32);tl.from("#c3 .number",{opacity:0,x:-12,duration:.35,ease:"power3.out"},41.12);tl.from("#c3 .title",{opacity:0,y:12,duration:.4,ease:"power2.out"},41.18);tl.from("#c3 .detail",{opacity:0,y:8,duration:.45,ease:"sine.out"},41.24);tl.from("#c3 .tag",{opacity:0,duration:.4},41.2);tl.from("#v3",{opacity:0,duration:.10,ease:"none"},41);tl.fromTo('#progress',{scaleX:0},{scaleX:1,duration:55,ease:'none'},0);window.__timelines['s07-demo']=tl;</script></body></html>