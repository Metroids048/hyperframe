{
  "meta": {
    "lastTouchedVersion": "2026.6.11"
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true,
          "images": {
            "allowUrl": false,
            "maxBytes": 8388608
          },
          "files": {
            "allowUrl": false
          }
        },
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "agents": {
    "list": [
      {
        "id": "commerce-control",
        "default": true,
        "workspace": "${VIDEO_AGENT_OPENCLAW_WORKSPACE}",
        "model": {
          "primary": "${OPENCLAW_COMMERCE_CONTROL_BACKEND_MODEL}"
        },
        "skills": [
          "commerce-orchestrator",
          "commerce-product-launch",
          "commerce-product-detail",
          "commerce-product-demo",
          "commerce-product-collection",
          "commerce-product-promotion",
          "commerce-product-faq",
          "commerce-general",
          "commerce-edit-and-variant",
          "commerce-hyperframes",
          "commerce-audio-captions",
          "commerce-recovery-delivery"
        ],
        "tools": {
          "allow": [
            "video_prepare",
            "video_resource_search",
            "video_web_research",
            "video_project_list",
            "video_project_open",
            "video_task",
            "video_job_status",
            "video_result",
            "video_cancel"
          ],
          "elevated": {
            "enabled": false
          }
        }
      },
      {
        "id": "commerce-stage",
        "workspace": "${VIDEO_AGENT_OPENCLAW_STAGE_WORKSPACE}",
        "model": {
          "primary": "${OPENCLAW_COMMERCE_STAGE_BACKEND_MODEL}"
        },
        "skills": [],
        "tools": {
          "allow": [
            "video_project_list",
            "video_project_open",
            "video_job_status",
            "video_result"
          ],
          "elevated": {
            "enabled": false
          }
        }
      }
    ]
  },
  "tools": {
    "deny": [
      "read",
      "write",
      "edit",
      "apply_patch",
      "exec",
      "process",
      "web_search",
      "web_fetch",
      "browser",
      "sessions_list",
      "sessions_history",
      "sessions_send",
      "sessions_spawn",
      "subagents"
    ],
    "media": {
      "video": {
        "enabled": true,
        "maxBytes": 67108864,
        "maxChars": 800,
        "attachments": {
          "mode": "first",
          "maxAttachments": 1
        }
      }
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "commerce-engine",
      "memory-core"
    ],
    "deny": [
      "browser",
      "canvas"
    ],
    "load": {
      "paths": [
        "${VIDEO_AGENT_OPENCLAW_PLUGIN}"
      ]
    },
    "entries": {
      "commerce-engine": {
        "enabled": true,
        "config": {
          "bridgeUrl": "${VIDEO_AGENT_BRIDGE_URL}",
          "bridgeTokenEnv": "OPENCLAW_BRIDGE_TOKEN",
          "workspaceId": "${VIDEO_AGENT_WORKSPACE_ID}"
        }
      }
    }
  }
}
